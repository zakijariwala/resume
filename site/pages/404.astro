---
import Base from '../layouts/Base.astro';
---
<Base title="Not found" noindex>
  <section class="section container">
    <span class="eyebrow">404</span>
    <h1>That page isn't here.</h1>
    <p class="muted">It may have been moved or taken offline.</p>
    <p><a class="btn" href="/">Home</a> <a class="btn btn-ghost" href="/work/">All work</a></p>
  </section>
</Base>

<style>
  h1 { font-size: var(--step-4); margin: 1rem 0; }
  p:last-child { display: flex; gap: 0.75rem; margin-top: 2rem; }
</style>
