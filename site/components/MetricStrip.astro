---
interface Props { metrics: { value: string; label: string }[]; caption?: string }
const { metrics, caption } = Astro.props;
---
<figure class="strip">
  <dl>
    {metrics.map((m) => (
      <div>
        <dt class="label">{m.label}</dt>
        <dd class="value">{m.value}</dd>
      </div>
    ))}
  </dl>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .strip { margin: 0; }
  dl { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); margin: 0; border-top: 1px solid var(--line); border-left: 1px solid var(--line); }
  dl > div { display: flex; flex-direction: column-reverse; justify-content: flex-end; padding: 1.25rem 1.1rem; border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  dd, dt { margin: 0; }
  .value { font: 500 var(--step-3)/1 var(--font-display); color: var(--text); }
  .label { margin-top: 0.5rem; font-size: var(--step--1); color: var(--muted); line-height: 1.4; }
  figcaption { margin-top: 0.75rem; font: 400 0.75rem/1.4 var(--font-mono); color: var(--faint); }
</style>
