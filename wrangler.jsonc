// One Worker serves the static site (Astro build in ./dist) and the dynamic routes.
// Setup steps: docs/SETUP.md
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zakijariwala",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/internal/*", "/api/*", "/admin", "/admin/*", "/r/*", "/resume.pdf", "/media/*", "/work/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "zakijariwala", "database_id": "REPLACE_WITH_D1_ID", "migrations_dir": "worker/migrations" }
  ],
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "zakijariwala" }],
  // Email Routing must be enabled on the zone and OWNER_EMAIL verified as a destination.
  "send_email": [{ "name": "EMAIL" }],
  "triggers": { "crons": ["0 3 * * 1"] },
  "observability": { "enabled": true },
  "vars": {
    "SITE_URL": "https://zakijariwala.space",
    "SITE_REPO": "zakijariwala/resume",
    "OWNER_EMAIL": "",
    "SENDER_EMAIL": "portfolio@zakijariwala.space",
    "TURNSTILE_SITE_KEY": "",
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": ""
  }
}
