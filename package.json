{
  "name": "zakijariwala-space",
  "type": "module",
  "private": true,
  "version": "2.0.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "wrangler dev",
    "check": "astro check && tsc -p worker/tsconfig.json --noEmit",
    "sync": "node --experimental-strip-types scripts/sync.ts",
    "db:migrate:local": "wrangler d1 migrations apply zakijariwala --local",
    "db:migrate:remote": "wrangler d1 migrations apply zakijariwala --remote",
    "deploy": "wrangler deploy"
  },
  "engines": {
    "node": ">=22.6"
  },
  "dependencies": {
    "astro": "^5.18.2",
    "hono": "^4.13.9",
    "yaml": "^2.9.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@cloudflare/workers-types": "^5.20260927.1",
    "@types/node": "^22.20.4",
    "typescript": "^5.9.3",
    "wrangler": "^4.141.0"
  }
}
