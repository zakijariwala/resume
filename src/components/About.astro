---
import meta from '../data/meta.json';
import SectionHeader from './SectionHeader.astro';

const { about } = meta;
---

<section id="about" class="about-section section-spacing">
  <SectionHeader
    title="About"
    hideLabel={true}
  />

  <div class="about-grid">
    <!-- Left: sticky framing + callout -->
    <aside class="about-sidebar">
      <p class="about-framing fade-in">
        <span class="recruiter-only">{about.left_framing.recruiter}</span>
        <span class="dev-only">{about.left_framing.developer}</span>
        <span class="curious-only">{about.left_framing.curious}</span>
        <span class="infra-only">{about.left_framing.infrastructure}</span>
      </p>

      {about.callout && (
        <div class="callout fade-in" style="transition-delay: 0.1s;">
          <p>{about.callout}</p>
        </div>
      )}

      <img src="/illust-path-of-supplication.png" class="about-illust fade-in" alt="" aria-hidden="true" loading="lazy" width="400" height="160" style="transition-delay: 0.15s;" />
    </aside>

    <!-- Right: prose -->
    <div class="about-prose">
      <!-- Recruiter mode -->
      <div class="recruiter-only">
        {about.paragraphs.recruiter.map((t, i) => (
          <p class="about-para fade-in" style={`transition-delay: ${i * 0.05}s`}>{t}</p>
        ))}
      </div>

      <!-- Infrastructure mode -->
      <div class="infra-only">
        {about.paragraphs.infrastructure.map((t, i) => (
          <p class="about-para fade-in" style={`transition-delay: ${i * 0.05}s`}>{t}</p>
        ))}
      </div>

      <!-- Developer mode -->
      <div class="dev-only">
        {about.paragraphs.developer.map((t, i) => (
          <p class="about-para fade-in" style={`transition-delay: ${i * 0.05}s`}>{t}</p>
        ))}
      </div>

      <!-- Curious mode. The first two paragraphs carry the narrative; the rest
           is there for anyone who wants it, without making the homepage long. -->
      <div class="curious-only">
        <p class="about-para fade-in">{about.paragraphs.curious_p1}</p>
        <p class="about-para fade-in" style="transition-delay: 0.05s;">{about.paragraphs.curious_p2}</p>
        <details class="about-more">
          <summary class="about-more-summary">
            <span>More on how I got here</span>
            <i class="ti ti-chevron-down" aria-hidden="true"></i>
          </summary>
          <p class="about-para">{about.paragraphs.curious_p3}</p>
          <p class="about-para">{about.paragraphs.curious_p4}</p>
        </details>
      </div>
    </div>
  </div>
</section>

<style>
.about-more {
  margin-top: var(--space-4);
  border-top: 1px solid var(--border);
  padding-top: var(--space-3);
}
.about-more-summary {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  cursor: pointer;
  list-style: none;
  font-family: var(--font-mono);
  font-size: var(--text-xs);
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: var(--text-muted);
  transition: color var(--motion-fast);
}
.about-more-summary::-webkit-details-marker { display: none; }
.about-more-summary:hover,
.about-more[open] .about-more-summary { color: var(--accent-text); }
.about-more-summary:focus-visible {
  outline: 2px solid var(--accent);
  outline-offset: 2px;
  border-radius: var(--radius-xs);
}
.about-more-summary i { transition: transform var(--motion-fast); }
.about-more[open] .about-more-summary i { transform: rotate(180deg); }
.about-more .about-para:first-of-type { margin-top: var(--space-4); }
@media (prefers-reduced-motion: reduce) {
  .about-more-summary i { transition: none; }
}

.about-section {
  padding: var(--section-padding) 0;
  border-bottom: 1px solid var(--border);
}
.about-grid {
  display: grid;
  grid-template-columns: 240px 1fr;
  gap: var(--space-12);
  align-items: start;
}
@media (max-width: 768px) {
  .about-grid {
    grid-template-columns: 1fr;
    gap: var(--space-8);
  }
}
.about-sidebar {
  position: sticky;
  top: calc(var(--nav-height) + var(--space-8));
  display: flex;
  flex-direction: column;
  gap: var(--space-5);
}
@media (max-width: 768px) {
  .about-sidebar { position: static; }
}
.about-illust {
  display: block;
  width: 100%;
  height: 160px;
  object-fit: cover;
  object-position: center;
  border-radius: var(--radius-sm);
}

.about-framing {
  font-size: var(--text-sm);
  color: var(--text-muted);
  line-height: 1.7;
  margin: 0;
}
.about-prose {
  display: flex;
  flex-direction: column;
  gap: 0;
}
.about-para {
  font-size: var(--text-base);
  color: var(--text-muted);
  line-height: 1.75;
  margin: 0 0 var(--space-5);
}
.about-para:last-child { margin-bottom: 0; }
[data-mode="curious"] .about-para {
  font-size: var(--text-lg);
  line-height: 1.8;
}
</style>
