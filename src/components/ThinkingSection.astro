---
import thinking from '../data/thinking.json';
import SectionHeader from './SectionHeader.astro';
---

<section id="thinking" class="section-spacing" style="border-bottom: 1px solid var(--border);">
  <SectionHeader
    label="PROCESS"
    labelDev="// process"
    labelCurious="How I decide what to build"
    labelInfra="OPERATING PRINCIPLES"
    title="How I think"
  />

  <ol class="think-flow">
    {thinking.map((s, i) => (
      <li class={`think-step fade-in cat-${s.cat}`} style={`transition-delay: ${i * 0.05}s`}>
        <div class="think-head">
          <span class="think-index" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <h3 class="think-name">{s.step}</h3>
        </div>
        <p class="think-body">{s.body}</p>
        <div class="think-evidence">
          <p class="think-evidence-text">{s.evidence}</p>
          <a class="think-link" href={`#project-${s.project_id}`}>{s.project_name} →</a>
        </div>
      </li>
    ))}
  </ol>
</section>

<style>
.section-spacing { padding: var(--section-padding) 0; }

.think-flow {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: var(--space-4);
  list-style: none;
  margin: 0;
  padding: 0;
  counter-reset: none;
}
.think-step {
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
  padding-top: var(--space-4);
  /* The flow reads left to right through the top rule, which carries the
     step's category colour. No arrow glyphs to fight with screen readers —
     the list is ordered, so the sequence is in the markup. */
  border-top: 2px solid var(--cat-border, var(--border-strong));
  min-width: 0;
}
.think-head {
  display: flex;
  align-items: baseline;
  gap: var(--space-2);
}
.think-index {
  font-family: var(--font-mono);
  font-size: var(--text-xs);
  color: var(--cat-color, var(--text-disabled));
  font-weight: 600;
}
.think-name {
  font-family: var(--font-display);
  font-size: var(--text-lg);
  font-weight: 400;
  line-height: 1.2;
  color: var(--text);
  margin: 0;
}
.think-body {
  font-size: var(--text-sm);
  line-height: 1.65;
  color: var(--text-muted);
  margin: 0;
}
.think-evidence {
  margin-top: auto;
  padding-top: var(--space-3);
  border-top: 1px solid var(--border);
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
}
.think-evidence-text {
  font-size: var(--text-xs);
  line-height: 1.6;
  color: var(--text-muted);
  margin: 0;
}
.think-link {
  font-family: var(--font-mono);
  font-size: var(--text-xs);
  color: var(--cat-color, var(--accent-text));
  text-decoration: none;
}
.think-link:hover { text-decoration: underline; }
.think-link:focus-visible {
  outline: 2px solid var(--accent);
  outline-offset: 2px;
  border-radius: var(--radius-xs);
}

@media (max-width: 1024px) {
  .think-flow { grid-template-columns: repeat(2, 1fr); gap: var(--space-6); }
}
@media (max-width: 640px) {
  .think-flow { grid-template-columns: 1fr; gap: var(--space-5); }
}
</style>
