---
const year = new Date().getFullYear();
const built = new Date().toISOString().slice(0, 10);
---

<footer class="dfoot">
  <div class="wrap dfoot-row">
    <span>© {year} mohammad zaki jariwala</span>
    <span class="d-num">build: {built}</span>
    <span>navi mumbai, in</span>
  </div>
</footer>

<style>
.dfoot {
  border-top: 1px solid var(--line);
  padding: 20px 0;
}
.dfoot-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  flex-wrap: wrap;
  font-family: var(--font-mono);
  font-size: 11px;
  color: var(--faint);
}
</style>
