---
import meta from '../../data/meta.json';

const { photo_developer, pdf_path, github } = meta;
---

<section class="dhero" id="top">
  <div class="wrap dhero-grid">

    <div class="dhero-spec rv">
      <p class="d-label">identity</p>
      <dl class="dhero-dl">
        <div class="dhero-row">
          <dt>name:</dt>
          <dd>Mohammad Zaki Jariwala</dd>
        </div>
        <div class="dhero-row">
          <dt>role:</dt>
          <dd>systems engineer &rarr; ai product builder</dd>
        </div>
        <div class="dhero-row">
          <dt>uptime:</dt>
          <dd><span class="d-num">99.999%</span> &middot; 30,000+ users &middot; tier-1 bank</dd>
        </div>
        <div class="dhero-row">
          <dt>shipped:</dt>
          <dd><span class="d-num">4</span> products, 0&rarr;1, solo</dd>
        </div>
        <div class="dhero-row">
          <dt>location:</dt>
          <dd>mumbai &middot; relocation-ready</dd>
        </div>
        <div class="dhero-row">
          <dt>status:</dt>
          <dd><span class="d-dot" aria-hidden="true"></span> open to work</dd>
        </div>
      </dl>

      <div class="dhero-actions">
        <a href="#work" class="dhero-btn dhero-btn--fill">view work</a>
        <a href={github} target="_blank" rel="noopener noreferrer" class="dhero-btn">
          github <i class="ti ti-arrow-up-right" aria-hidden="true"></i>
        </a>
        <a href={pdf_path} download class="dhero-btn">
          resume.pdf <i class="ti ti-download" aria-hidden="true"></i>
        </a>
      </div>
    </div>

    <div class="dhero-aside rv">
      <div class="dhero-avatar">
        <img
          src={photo_developer}
          alt="Mohammad Zaki Jariwala"
          width="480"
          height="594"
          loading="eager"
          fetchpriority="high"
        />
        <span class="dhero-avatar-cap d-label">jariwala, m.z.</span>
      </div>

      <div class="dhero-modes" aria-label="Switch audience mode">
        <span class="dhero-modes-label">viewing as: <strong>dev</strong></span>
        <div class="dhero-modes-row">
          <a href="/?mode=recruiter" class="dhero-modes-btn">recruiter</a>
          <a href="/curious" class="dhero-modes-btn">curious</a>
        </div>
      </div>
    </div>

  </div>
</section>

<style>
.dhero {
  min-height: 100dvh;
  display: flex;
  align-items: center;
  padding-top: 56px; /* clears fixed nav */
}
.dhero-grid {
  display: grid;
  grid-template-columns: 1fr auto;
  gap: clamp(32px, 6vw, 96px);
  align-items: center;
}

.dhero-dl { margin: 0; }
.dhero-row {
  display: grid;
  grid-template-columns: 110px 1fr;
  gap: 16px;
  padding: 10px 0;
  border-bottom: 1px solid var(--line);
  font-family: var(--font-mono);
  font-size: clamp(13px, 1.6vw, 16px);
}
.dhero-row dt { color: var(--faint); margin: 0; }
.dhero-row dd { color: var(--text); margin: 0; }

.dhero-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  margin-top: 28px;
}
.dhero-btn {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-family: var(--font-mono);
  font-size: 13px;
  color: var(--text);
  text-decoration: none;
  border: 1px solid var(--line-strong);
  padding: 9px 18px;
  transition: border-color 0.15s ease, background 0.15s ease, color 0.15s ease;
}
.dhero-btn:hover { border-color: var(--text); }
.dhero-btn--fill {
  background: var(--accent);
  border-color: var(--accent);
  color: var(--bg);
  font-weight: 500;
}
.dhero-btn--fill:hover { background: var(--text); border-color: var(--text); }

.dhero-aside {
  display: flex;
  align-items: flex-start;
  gap: 16px;
}
.dhero-avatar {
  width: clamp(120px, 16vw, 200px);
  flex-shrink: 0;
}

/* Mode switcher beside the photo — fills the space alongside it */
.dhero-modes {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 12px;
  font-family: var(--font-mono);
}
.dhero-modes-label {
  font-size: 14px;
  letter-spacing: 0.04em;
  color: var(--muted);
}
.dhero-modes-label strong { color: var(--accent); font-weight: 500; }
.dhero-modes-row {
  display: flex;
  gap: 10px;
}
.dhero-modes-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 44px;
  font-size: 14px;
  color: var(--muted);
  text-decoration: none;
  border: 1px solid var(--line-strong);
  transition: color 0.15s ease, border-color 0.15s ease, background 0.15s ease;
}
.dhero-modes-btn:hover { color: var(--text); border-color: var(--accent); background: rgba(61, 220, 132, 0.06); }
.dhero-avatar img {
  width: 100%;
  aspect-ratio: 1;
  object-fit: cover;
  object-position: center 15%;
  border: 1px solid var(--line-strong);
  filter: saturate(0.7) contrast(1.05);
}
.dhero-avatar-cap {
  display: block;
  margin-top: 8px;
}
.dhero-avatar-cap::before { content: ''; }

@media (max-width: 640px) {
  .dhero-grid {
    grid-template-columns: 1fr;
    gap: 32px;
  }
  .dhero-aside { order: -1; }
  .dhero-avatar { width: 104px; }
  .dhero-row { grid-template-columns: 92px 1fr; gap: 10px; }
}
</style>
