---
const phone = "919157564545";
const message = "i saw your portfolio website and was interested in getting something built like this";
const href = `https://wa.me/${phone}?text=${encodeURIComponent(message)}`;
---

<a
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  class="floating-hire-cta"
  aria-label="Want a site like this? Message me on WhatsApp"
>
  <span class="fhc-icon" aria-hidden="true">
    <i class="ti ti-brand-whatsapp"></i>
  </span>
  <span class="fhc-label">Want a site like this?</span>
</a>

<style>
.floating-hire-cta {
  position: fixed;
  bottom: var(--space-6);
  right: var(--space-6);
  z-index: 60;
  display: inline-flex;
  align-items: center;
  gap: var(--space-3);
  padding: var(--space-3) var(--space-5);
  border-radius: 9999px;
  background: var(--whatsapp);
  color: #fff;
  font-family: var(--font-mono);
  font-size: var(--text-xs);
  font-weight: 600;
  letter-spacing: 0.01em;
  text-decoration: none;
  border: 1px solid var(--whatsapp-strong);
  transition: background var(--motion-fast), transform var(--motion-fast);
  animation: fhc-pulse 2.6s ease-in-out infinite;
  will-change: box-shadow;
}
.floating-hire-cta:hover {
  background: var(--whatsapp-strong);
  transform: translateY(-1px);
}
.fhc-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 20px;
  line-height: 1;
}
.fhc-label {
  white-space: nowrap;
}
@keyframes fhc-pulse {
  0%   { box-shadow: 0 0 0 0 var(--whatsapp-glow); }
  70%  { box-shadow: 0 0 0 12px var(--whatsapp-glow-soft); }
  100% { box-shadow: 0 0 0 0 var(--whatsapp-glow-soft); }
}
@media (max-width: 600px) {
  .floating-hire-cta {
    bottom: var(--space-4);
    right: var(--space-4);
    padding: var(--space-3);
  }
  .fhc-label {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
}
@media (prefers-reduced-motion: reduce) {
  .floating-hire-cta { animation: none; }
}
</style>
