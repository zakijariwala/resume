---
interface Bullet {
  text: string;
  audience: string[];
}

interface Props {
  project: {
    id: string;
    name: string;
    tagline: string;
    one_line_summary: string;
    featured_metric: string;
    why_i_built_it: string;
    tech: string[];
    github: string;
    live_url?: string;
    year: string;
    category?: 'ai' | 'product' | 'infra' | 'primary';
    infra_order?: number;
    featured_infrastructure?: boolean;
    bullets: Bullet[];
  };
}

const { project } = Astro.props;
// The Infrastructure featured slot renders this project as a full-width card,
// so its grid card is withheld from that mode to avoid a duplicate.
const gridHidden = project.featured_infrastructure ? 'hide-in-infrastructure' : '';
const CATEGORY_LABEL: Record<string, string> = {
  ai: 'AI', product: 'Product', infra: 'Infrastructure', primary: 'Product',
};
const category = project.category ?? 'primary';
const categoryLabel = CATEGORY_LABEL[category];
const visibleTech = project.tech.slice(0, 6);
const isPrivate = !project.github || project.github === 'private';
const hasLive = !!(project.live_url && project.live_url !== '');
---

<div
  class={`proj-card card fade-in cat-${category} ${gridHidden}`}
  id={`project-${project.id}`}
  style={`--infra-order: ${project.infra_order ?? 0}`}
>
  <div class="proj-header">
    <div class="proj-meta">
      <span class={`category-badge cat-${category}`}>{categoryLabel}</span>
      <span class="project-tagline">{project.tagline}</span>
    </div>
    <span class="proj-year recruiter-dev infra-only">{project.year}</span>
  </div>

  <h3 class="proj-name">{project.name}</h3>
  <p class="proj-summary">{project.one_line_summary}</p>

  {project.featured_metric && (
    <p class="proj-outcome">{project.featured_metric}</p>
  )}

  <div class="stack-chips">
    {visibleTech.map(t => (
      <span class="stack-chip">{t}</span>
    ))}
  </div>

  <details class="proj-details">
    <summary class="proj-details-summary">
      <span>How it was built</span>
      <i class="ti ti-chevron-down" aria-hidden="true"></i>
    </summary>
    <ul class="proj-bullets">
      {project.bullets.map(bullet => (
        <li data-audience={bullet.audience.join(',')}>{bullet.text}</li>
      ))}
    </ul>
  </details>

  {project.why_i_built_it && (
    <div class="callout curious-only">
      <p class="why-text">{project.why_i_built_it}</p>
    </div>
  )}

  <div class="proj-card-footer">
    {hasLive && (
      <a
        href={project.live_url}
        target="_blank"
        rel="noopener noreferrer"
        class="proj-live-link all-modes"
        aria-label={`View ${project.name} live`}
      >
        <i class="ti ti-external-link"></i>
        <span>View live</span>
      </a>
    )}
    {!isPrivate ? (
      <a
        href={project.github}
        target="_blank"
        rel="noopener noreferrer"
        class="proj-github-link dev-only infra-only"
        aria-label={`View ${project.name} on GitHub`}
      >
        <i class="ti ti-brand-github"></i>
        <span>View repo</span>
      </a>
    ) : (
      <span class="proj-private dev-only infra-only">
        <i class="ti ti-lock"></i>
        <span>Private repo</span>
      </span>
    )}
  </div>
</div>

<style is:global>
/* Shared with FeaturedProjectCard, which is a separate component. */
.proj-details-summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-2);
  cursor: pointer;
  font-family: var(--font-mono);
  font-size: var(--text-xs);
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: var(--text-muted);
  list-style: none;
  padding: var(--space-1) 0;
  transition: color var(--motion-fast);
}
.proj-details-summary::-webkit-details-marker { display: none; }
.proj-details-summary:hover,
.proj-details[open] .proj-details-summary { color: var(--cat-color, var(--accent-text)); }
.proj-details-summary i { transition: transform var(--motion-fast); }
.proj-details[open] .proj-details-summary i { transform: rotate(180deg); }
.proj-details-summary:focus-visible {
  outline: 2px solid var(--accent);
  outline-offset: 2px;
  border-radius: var(--radius-xs);
}
@media (prefers-reduced-motion: reduce) {
  .proj-details-summary i { transition: none; }
}

[data-mode="recruiter"] .proj-bullets li[data-audience]:not([data-audience*="recruiter"]):not([data-audience*="management"]) {
  display: none;
}
[data-mode="developer"] .proj-bullets li[data-audience]:not([data-audience*="developer"]) { display: none; }
[data-mode="curious"]   .proj-bullets li[data-audience]:not([data-audience*="curious"])   { display: none; }
[data-mode="infrastructure"] .proj-bullets li[data-audience]:not([data-audience*="infrastructure"]) { display: none; }
[data-mode="infrastructure"] .proj-card.hide-in-infrastructure { display: none; }
</style>

<style>
.proj-card {
  border-left: 3px solid var(--cat-border, var(--border));
  transition: border-color var(--motion-fast);
  display: flex;
  flex-direction: column;
  gap: var(--space-4);
  height: 100%;
  /* Prevent grid blowout: a grid item defaults to min-width:auto
     (min-content), so a nowrap .project-metric would force the card
     wider than its column. Allow it to shrink to the column width. */
  min-width: 0;
}
.proj-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: var(--space-3);
  flex-wrap: wrap;
}
.proj-meta {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  flex-wrap: wrap;
}
.project-tagline {
  font-family: var(--font-mono);
  font-size: var(--text-xs);
  color: var(--text-muted);
  letter-spacing: 0.04em;
}
/* Scoped override: allow the metric to wrap inside a grid card rather
   than force a nowrap line that can overflow on narrow viewports.
   Only affects ProjectCard — the featured card keeps its own style. */
.project-metric {
  white-space: normal;
}
.proj-year {
  font-family: var(--font-mono);
  font-size: var(--text-xs);
  color: var(--text-disabled);
}
.proj-name {
  font-family: var(--font-display);
  font-size: var(--text-lg);
  font-weight: 400;
  color: var(--text);
  letter-spacing: -0.01em;
  margin: 0;
  line-height: 1.25;
  font-optical-sizing: auto;
}
.proj-summary {
  font-size: var(--text-sm);
  color: var(--text-muted);
  line-height: 1.7;
  margin: 0;
}

/* The key outcome, stated once and given its category colour. */
.proj-outcome {
  font-family: var(--font-display);
  font-size: var(--text-lg);
  line-height: 1.3;
  color: var(--cat-color, var(--accent-text));
  margin: 0;
  text-wrap: balance;
}

.proj-details {
  margin-top: auto;
  border-top: 1px solid var(--border);
  padding-top: var(--space-3);
}
.proj-details-summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-2);
  cursor: pointer;
  font-family: var(--font-mono);
  font-size: var(--text-xs);
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: var(--text-muted);
  list-style: none;
  padding: var(--space-1) 0;
  transition: color var(--motion-fast);
}
.proj-details-summary::-webkit-details-marker { display: none; }
.proj-details-summary:hover { color: var(--cat-color, var(--accent-text)); }
.proj-details-summary i { transition: transform var(--motion-fast); }
.proj-details[open] .proj-details-summary i { transform: rotate(180deg); }
.proj-details[open] .proj-details-summary { color: var(--cat-color, var(--accent-text)); }
.proj-details .proj-bullets { padding-top: var(--space-3); }
@media (prefers-reduced-motion: reduce) {
  .proj-details-summary i { transition: none; }
}
.proj-bullets {
  list-style: disc;
  padding-left: var(--space-5);
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
  font-size: var(--text-sm);
  color: var(--text-muted);
  line-height: 1.65;
  margin: 0;
}
.why-text {
  font-size: var(--text-sm);
  color: var(--text-muted);
  line-height: 1.75;
  font-style: italic;
  margin: 0;
}
.proj-card-footer {
  padding-top: var(--space-3);
  border-top: 1px solid var(--border);
  display: flex;
  align-items: center;
  gap: var(--space-4);
  flex-wrap: wrap;
}
.proj-github-link,
.proj-live-link,
.proj-private {
  display: inline-flex;
  align-items: center;
  gap: var(--space-2);
  font-family: var(--font-mono);
  font-size: var(--text-xs);
  color: var(--accent-text);
  text-decoration: none;
  transition: color var(--motion-fast);
}
.proj-github-link:hover,
.proj-live-link:hover { text-decoration: underline; }
.proj-private { color: var(--text-disabled); font-style: italic; }
</style>
