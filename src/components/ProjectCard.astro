---
interface Bullet {
  text: string;
  audience: string[];
}

interface Props {
  project: {
    id: string;
    name: string;
    tagline: string;
    one_line_summary: string;
    featured_metric: string;
    why_i_built_it: string;
    tech: string[];
    github: string;
    live_url?: string;
    image_url?: string;
    year: string;
    bullets: Bullet[];
  };
}

const { project } = Astro.props;
const visibleTech = project.tech.slice(0, 6);
const isPrivate = !project.github || project.github === 'private';
const hasLive = !!(project.live_url && project.live_url !== '');
---

<div class="proj-card card fade-in" id={`project-${project.id}`}>
  {project.image_url && (
    <div class="proj-img-wrap">
      <img src={project.image_url} alt="" aria-hidden="true" class="proj-img" loading="lazy" width="400" height="120" />
    </div>
  )}
  <div class="proj-header">
    <div class="proj-meta">
      <span class="project-tagline">{project.tagline}</span>
      <span class="proj-year recruiter-dev">{project.year}</span>
    </div>
    {project.featured_metric && (
      <span class="project-metric">{project.featured_metric}</span>
    )}
  </div>

  <h3 class="proj-name">{project.name}</h3>
  <p class="proj-summary">{project.one_line_summary}</p>

  <div class="stack-chips">
    {visibleTech.map(t => (
      <span class="stack-chip">{t}</span>
    ))}
  </div>

  <ul class="proj-bullets">
    {project.bullets.map(bullet => (
      <li data-audience={bullet.audience.join(',')}>{bullet.text}</li>
    ))}
  </ul>

  {project.why_i_built_it && (
    <div class="callout curious-only">
      <p class="why-text">{project.why_i_built_it}</p>
    </div>
  )}

  <div class="proj-card-footer">
    {hasLive && (
      <a
        href={project.live_url}
        target="_blank"
        rel="noopener noreferrer"
        class="proj-live-link all-modes"
        aria-label={`View ${project.name} live`}
      >
        <i class="ti ti-external-link"></i>
        <span>View live</span>
      </a>
    )}
    {!isPrivate ? (
      <a
        href={project.github}
        target="_blank"
        rel="noopener noreferrer"
        class="proj-github-link dev-only"
        aria-label={`View ${project.name} on GitHub`}
      >
        <i class="ti ti-brand-github"></i>
        <span>View repo</span>
      </a>
    ) : (
      <span class="proj-private dev-only">
        <i class="ti ti-lock"></i>
        <span>Private repo</span>
      </span>
    )}
  </div>
</div>

<style is:global>
[data-mode="recruiter"] .proj-bullets li[data-audience]:not([data-audience*="recruiter"]):not([data-audience*="management"]) {
  display: none;
}
[data-mode="developer"] .proj-bullets li[data-audience]:not([data-audience*="developer"]) { display: none; }
[data-mode="curious"]   .proj-bullets li[data-audience]:not([data-audience*="curious"])   { display: none; }
</style>

<style>
.proj-img-wrap {
  margin: calc(-1 * var(--card-padding)) calc(-1 * var(--card-padding)) 0;
}
.proj-img {
  display: block;
  width: 100%;
  height: 120px;
  object-fit: cover;
  object-position: center;
  border-radius: calc(var(--card-radius) - 1px) calc(var(--card-radius) - 1px) 0 0;
}

.proj-card {
  display: flex;
  flex-direction: column;
  gap: var(--space-4);
  height: 100%;
  /* Prevent grid blowout: a grid item defaults to min-width:auto
     (min-content), so a nowrap .project-metric would force the card
     wider than its column. Allow it to shrink to the column width. */
  min-width: 0;
}
.proj-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: var(--space-3);
  flex-wrap: wrap;
}
.proj-meta {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  flex-wrap: wrap;
}
.project-tagline {
  font-family: var(--font-mono);
  font-size: var(--text-xs);
  color: var(--text-muted);
  letter-spacing: 0.04em;
}
/* Scoped override: allow the metric to wrap inside a grid card rather
   than force a nowrap line that can overflow on narrow viewports.
   Only affects ProjectCard — the featured card keeps its own style. */
.project-metric {
  white-space: normal;
}
.proj-year {
  font-family: var(--font-mono);
  font-size: var(--text-xs);
  color: var(--text-disabled);
}
.proj-name {
  font-family: var(--font-display);
  font-size: var(--text-lg);
  font-weight: 400;
  color: var(--text);
  letter-spacing: -0.01em;
  margin: 0;
  line-height: 1.25;
  font-optical-sizing: auto;
}
.proj-summary {
  font-size: var(--text-sm);
  color: var(--text-muted);
  line-height: 1.7;
  margin: 0;
  flex: 1;
}
.proj-bullets {
  list-style: disc;
  padding-left: var(--space-5);
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
  font-size: var(--text-sm);
  color: var(--text-muted);
  line-height: 1.65;
  margin: 0;
}
.why-text {
  font-size: var(--text-sm);
  color: var(--text-muted);
  line-height: 1.75;
  font-style: italic;
  margin: 0;
}
.proj-card-footer {
  margin-top: auto;
  padding-top: var(--space-3);
  border-top: 1px solid var(--border);
  display: flex;
  align-items: center;
  gap: var(--space-4);
  flex-wrap: wrap;
}
.proj-github-link,
.proj-live-link,
.proj-private {
  display: inline-flex;
  align-items: center;
  gap: var(--space-2);
  font-family: var(--font-mono);
  font-size: var(--text-xs);
  color: var(--accent-text);
  text-decoration: none;
  transition: color var(--motion-fast);
}
.proj-github-link:hover,
.proj-live-link:hover { text-decoration: underline; }
.proj-private { color: var(--text-disabled); font-style: italic; }
</style>
