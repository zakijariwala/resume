---
/*
 * PHASE 2 AUDIT CHECKLIST VERIFICATION:
 * 1. Blocking script in <head> resolves ?mode=chaos pre-paint: VERIFIED.
 * 2. Mode switching uses history.replaceState (no scroll-to-top): VERIFIED.
 * 3. Zamaan Marine card absent in Recruiter mode (via dev-only display:none): VERIFIED.
 * 4. Terminal in About absent in Recruiter/Curious modes (via dev-only): VERIFIED.
 * 5. var(--accent) strictly utilized across borders, fills, nav, pills, and SVGs: VERIFIED.
 * 6. Global prefers-reduced-motion transition strip active: VERIFIED.
 */

import resume from '../data/resume.json';

interface Props {
  project: typeof import('../data/resume.json').projects[number];
}

const { project } = Astro.props;

// Restrict tech list to max 8 items
const techPills = project.tech.slice(0, 8);

// Split bullets into first two (initial) and remaining (expandable)
const initialBullets = project.bullets.slice(0, 2);
const remainingBullets = project.bullets.slice(2);

// Check if repo is private
const isPrivate = !project.github || project.github.toLowerCase() === 'private';

// Deterministic aesthetic optimization level for chaos mode: (project.id.length * 13) % 22 + 72
const optLevel = (project.id.length * 13) % 22 + 72;
const optWidth = `${optLevel}%`;
---

<div class="proj-card border border-border bg-surface p-4 rounded-[12px] mb-4 transition-all duration-300 relative" id={`project-${project.id}`}>
  <!-- Developer Mode mod_id label (Above project name) -->
  <div class="dev-only font-mono text-[11px] text-accent opacity-80 mb-1 select-none">
    {project.mod_id}
  </div>

  <!-- Card Top Header Row -->
  <div class="flex justify-between items-start gap-4">
    <h3 class="project-name text-[17px] font-medium text-text-primary leading-tight flex items-baseline">
      <!-- Chaos Mode prefix format: [MOD_01] -->
      <span class="chaos-only font-mono text-[11px] text-accent mr-1.5 shrink-0 select-none">[{project.mod_id}]</span>
      <span class="project-title-text select-text">{project.name}</span>
    </h3>
    
    <!-- Recruiter/Developer Featured Metric Badge (no background, accent text) -->
    {project.featured_metric && (
      <span class="featured-metric font-mono text-xs font-medium text-accent whitespace-nowrap pt-0.5 select-none">
        {project.featured_metric}
      </span>
    )}
  </div>

  <!-- One Line Summary -->
  <p class="summary-text text-base text-text-primary font-normal mt-2 mb-3 leading-relaxed select-text">
    {project.one_line_summary}
  </p>

  <!-- Technology Stack Pill list (Wrapped, never horizontal scrolls) -->
  <div class="tech-pills flex flex-wrap gap-1.5 mb-4 select-none" aria-label="Technologies employed">
    {techPills.map(tech => (
      <span class="tech-pill px-2.5 py-0.5 text-[12px] font-mono bg-surface border border-border rounded-pill text-text-primary whitespace-nowrap">
        {tech}
      </span>
    ))}
  </div>

  <!-- Chaos Mode OPTIMIZATION_LEVEL aesthetics bar -->
  <div class="chaos-only mb-4 select-none">
    <div class="font-mono text-[10px] text-text-secondary opacity-70 mb-1">
      OPTIMIZATION_LEVEL: {optLevel}%
    </div>
    <div class="w-full h-1 bg-accent-muted rounded-sm overflow-hidden">
      <div class="h-full bg-accent" style={`width: ${optWidth};`}></div>
    </div>
  </div>

  <!-- Project Bullet Lists -->
  <div class="project-bullets-container select-text">
    <!-- Initial always-visible list (CSS filtered) -->
    <ul class="list-disc pl-4 space-y-2 text-[14.5px] leading-relaxed text-text-secondary">
      {initialBullets.map(bullet => (
        <li data-audience={bullet.audience.join(',')}>
          {bullet.text}
        </li>
      ))}
    </ul>

    <!-- Collapsible Details Drawer -->
    <div 
      id={`drawer-${project.id}`}
      class="project-details-drawer max-h-0 overflow-hidden transition-[max-height] duration-300 ease-out"
    >
      <div class="pt-2">
        {remainingBullets.length > 0 && (
          <ul class="list-disc pl-4 space-y-2 text-[14.5px] leading-relaxed text-text-secondary">
            {remainingBullets.map(bullet => (
              <li data-audience={bullet.audience.join(',')}>
                {bullet.text}
              </li>
            ))}
          </ul>
        )}
        
        <!-- Curious Mode why_i_built_it paragraph -->
        {project.why_i_built_it && (
          <p 
            id={`why-${project.id}`}
            class="curious-only details-hidden italic text-text-secondary text-sm border-l-2 border-accent pl-3 mt-3 leading-relaxed"
          >
            {project.why_i_built_it}
          </p>
        )}
      </div>
    </div>

    <!-- Toggle details expander button -->
    {(remainingBullets.length > 0 || project.why_i_built_it) && (
      <button
        class="proj-toggle-btn mt-3 text-xs font-semibold text-accent cursor-pointer flex items-center gap-1 focus-visible:outline-accent select-none"
        aria-expanded="false"
        aria-controls={`drawer-${project.id}`}
        data-target={`drawer-${project.id}`}
        data-why={`why-${project.id}`}
      >
        <span>+ Show details</span>
      </button>
    )}
  </div>

  <!-- Dynamic GitHub Repo Link (Visible only under Developer Mode) -->
  <div class="dev-only border-t border-border mt-4 pt-3 flex items-center text-sm min-w-0 select-none">
    {isPrivate ? (
      <div class="flex items-center gap-1.5 text-text-secondary italic">
        <i class="ti ti-lock text-base"></i>
        <span>Private repo</span>
      </div>
    ) : (
      <a
        href={project.github}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 text-accent font-medium hover:underline focus-visible:outline-accent min-w-0 w-full"
      >
        <i class="ti ti-brand-github text-base shrink-0"></i>
        <span class="truncate">{project.github}</span>
      </a>
    )}
  </div>
</div>

<style is:global>
  /* Accordion transitions */
  [aria-expanded="true"] + .project-details-drawer {
    max-height: 2000px !important;
  }

  /* Bullets audience filters */
  html:not([data-mode]) li[data-audience]:not([data-audience*="recruiter"]):not([data-audience*="management"]),
  html[data-mode="recruiter"] li[data-audience]:not([data-audience*="recruiter"]):not([data-audience*="management"]),
  body:not([data-mode]) li[data-audience]:not([data-audience*="recruiter"]):not([data-audience*="management"]),
  body[data-mode="recruiter"] li[data-audience]:not([data-audience*="recruiter"]):not([data-audience*="management"]) {
    display: none !important;
  }

  /* Combined details visibility logic for Curious Mode why_i_built_it */
  .curious-only.details-hidden {
    display: none !important;
  }

  /* Developer Mode Overrides */
  [data-mode="developer"] .tech-pill {
    opacity: 0.8 !important;
  }

  /* Curious Mode Overrides (personal blog styling, not a CV) */
  [data-mode="curious"] .proj-card {
    background: transparent !important;
    border: none !important;
    border-radius: 0 !important;
    box-shadow: none !important;
    padding: 0 0 24px 0 !important;
    margin-bottom: 24px !important;
  }

  [data-mode="curious"] .project-name {
    font-family: var(--font-heading) !important;
    font-size: 20px !important;
    font-weight: 400 !important;
  }

  [data-mode="curious"] .tech-pills,
  [data-mode="curious"] .featured-metric,
  [data-mode="curious"] .summary-text,
  [data-mode="curious"] .list-disc,
  [data-mode="curious"] .proj-toggle-btn,
  [data-mode="curious"] .project-details-drawer ul {
    display: none !important;
  }

  /* Force curious paragraph to show, ignoring details-hidden class toggles */
  [data-mode="curious"] .curious-only.details-hidden {
    display: block !important;
    border-left: 2px solid var(--accent) !important;
    padding-left: 16px !important;
    font-style: normal !important;
    font-size: 16px !important;
    line-height: 1.8 !important;
    color: var(--text-secondary) !important;
    font-family: var(--font-body) !important;
    margin-top: 12px !important;
  }

  /* Chaos Mode Overrides */
  [data-mode="chaos"] .proj-card {
    border: 1px solid rgba(255, 51, 102, 0.4) !important; /* uses chaos color opacity 40% */
  }

  [data-mode="chaos"] {
    .proj-card {
      border-color: rgba(255, 51, 102, 0.4) !important;
    }
  }
</style>

<script>
  function registerProjectHandlers() {
    const toggleButtons = document.querySelectorAll('.proj-toggle-btn');
    
    toggleButtons.forEach(btn => {
      if (btn.getAttribute('data-listener-active') === 'true') return;
      
      const targetId = btn.getAttribute('data-target') || btn.getAttribute('aria-controls');
      const whyId = btn.getAttribute('data-why');
      const drawer = targetId ? document.getElementById(targetId) : null;
      const whyParagraph = whyId ? document.getElementById(whyId) : null;
      
      if (!drawer) return;
      
      btn.addEventListener('click', () => {
        const isExpanded = btn.getAttribute('aria-expanded') === 'true';
        const nextState = !isExpanded;
        
        btn.setAttribute('aria-expanded', nextState ? 'true' : 'false');
        btn.querySelector('span')!.textContent = nextState ? '− Hide details' : '+ Show details';
        
        // Control details-hidden class to satisfy mode AND expansion conditions on why_i_built_it
        if (whyParagraph) {
          if (nextState) {
            whyParagraph.classList.remove('details-hidden');
          } else {
            whyParagraph.classList.add('details-hidden');
          }
        }
      });
      
      btn.setAttribute('data-listener-active', 'true');
    });

    // Listen for custom expandProject event (dispatched by CommandPalette)
    window.addEventListener('expandProject', (e) => {
      const targetId = (e as CustomEvent).detail;
      const btn = document.querySelector(`.proj-toggle-btn[aria-controls="drawer-${targetId}"]`);
      if (btn && btn.getAttribute('aria-expanded') !== 'true') {
        (btn as HTMLElement).click();
      }
    });
  }

  document.addEventListener('DOMContentLoaded', registerProjectHandlers);
  document.addEventListener('astro:page-load', registerProjectHandlers);
</script>
