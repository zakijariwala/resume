---
import projects from '../data/projects.json';
import SectionHeader from './SectionHeader.astro';
import FeaturedProjectCard from './FeaturedProjectCard.astro';
import ProjectCard from './ProjectCard.astro';

const featured = projects.find(p => p.featured);
const featuredInfra = projects.find(p => p.featured_infrastructure);

// Every non-featured card lives in a single grid. DOM order is the order
// recruiter, developer, and curious modes see; Infrastructure mode reorders
// with the CSS `order` property, driven by the --infra-order custom property
// each card carries. The divider is a full-width grid item so it moves too.
const rest = projects.filter(p => !p.featured);
const primary = rest.filter(p => p.priority === 'primary');
const secondary = rest.filter(p => p.priority === 'secondary');
---

<section id="projects" class="section-spacing" style="border-bottom: 1px solid var(--border);">
  <SectionHeader
    label="PROJECTS"
    labelDev="projects"
    labelCurious="Things I've built"
    labelInfra="SYSTEMS BUILT"
    title="Projects"
  />

  {featured && <FeaturedProjectCard project={featured} />}
  {featuredInfra && <FeaturedProjectCard project={featuredInfra} variant="infrastructure" />}

  <div class="projects-grid">
    {primary.map((project) => (
      <ProjectCard project={project} />
    ))}

    <div class="projects-divider" style="--infra-order: 35">
      <span class="divider-label recruiter-only">Other Projects</span>
      <span class="divider-label dev-only">// other_projects</span>
      <span class="divider-label curious-only">Other things I've made</span>
      <span class="divider-label infra-only">OTHER PROJECTS</span>
    </div>

    {secondary.map((project) => (
      <ProjectCard project={project} />
    ))}
  </div>
</section>

<style is:global>
[data-mode="infrastructure"] .projects-grid > * { order: var(--infra-order, 0); }
</style>

<script>
// Recruiter and Curious open on the outcome; Developer and Infrastructure want
// the implementation without an extra click. Reuses the mode-change event the
// switcher already dispatches, so there is no second source of truth.
const TECHNICAL_MODES = ['developer', 'infrastructure'];

// Setting .open fires a toggle event, so the "did the visitor touch this"
// listener has to ignore the changes we make ourselves.
let syncing = false;

function syncProjectDisclosures(mode: string) {
  const open = TECHNICAL_MODES.includes(mode);
  syncing = true;
  document.querySelectorAll<HTMLDetailsElement>('.proj-details').forEach(d => {
    if (d.dataset.userToggled === '1') return;
    d.open = open;
  });
  // toggle events are queued as tasks, so clear the flag after they drain.
  setTimeout(() => { syncing = false; }, 0);
}

document.addEventListener('DOMContentLoaded', () => {
  document.querySelectorAll<HTMLDetailsElement>('.proj-details').forEach(d => {
    d.addEventListener('toggle', () => {
      if (!syncing) d.dataset.userToggled = '1';
    });
  });
  syncProjectDisclosures(document.documentElement.dataset.mode || 'recruiter');
});

window.addEventListener('portfolio-mode-change', (e) => {
  syncProjectDisclosures((e as CustomEvent).detail.mode);
});
</script>

<style>
.section-spacing {
  padding: var(--section-padding) 0;
}
.projects-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--space-4);
}
.projects-divider {
  grid-column: 1 / -1;
  /* The grid gap (16px) now contributes to the divider's separation, so the
     margins are reduced to preserve the original 40px above / 24px below. */
  margin-top: var(--space-6);
  margin-bottom: var(--space-2);
  padding-bottom: var(--space-4);
  border-bottom: 1px solid var(--border);
}
.divider-label {
  font-family: var(--font-mono);
  font-size: var(--text-xs);
  color: var(--text-disabled);
  letter-spacing: 0.06em;
  text-transform: uppercase;
}
[data-mode="developer"] .divider-label {
  text-transform: none;
  letter-spacing: 0.02em;
  color: var(--accent-text);
  opacity: 0.6;
}
[data-mode="curious"] .divider-label {
  text-transform: none;
  letter-spacing: normal;
  font-family: var(--font-body);
  font-style: italic;
  color: var(--text-muted);
}
@media (max-width: 768px) {
  .projects-grid { grid-template-columns: 1fr; }
}
</style>
