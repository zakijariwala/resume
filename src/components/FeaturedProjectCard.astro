---
interface Bullet {
  text: string;
  audience: string[];
}

interface Props {
  /** 'infrastructure' renders this as the featured card for that mode only. */
  variant?: 'default' | 'infrastructure';
  project: {
    id: string;
    name: string;
    tagline: string;
    one_line_summary: string;
    featured_metric: string;
    why_i_built_it: string;
    tech: string[];
    github: string;
    year: string;
    category?: 'ai' | 'product' | 'infra' | 'primary';
    bullets: Bullet[];
  };
}

const { project, variant = 'default' } = Astro.props;
const variantClass = variant === 'infrastructure'
  ? 'show-in-infrastructure'
  : 'hide-in-infrastructure';
const isPrivate = !project.github || project.github === 'private';
const CATEGORY_LABEL: Record<string, string> = {
  ai: 'AI', product: 'Product', infra: 'Infrastructure', primary: 'Product',
};
const category = project.category ?? 'primary';
const categoryLabel = CATEGORY_LABEL[category];
---

<div
  class={`featured-card fade-in cat-${category} ${variantClass}`}
  id={variant === 'default' ? `project-${project.id}` : undefined}
>
  <div class="featured-card-header">
    <div class="featured-card-meta">
      <span class="featured-badge">Featured</span>
      <span class={`category-badge cat-${category}`}>{categoryLabel}</span>
      <span class="project-tagline">{project.tagline}</span>
      <span class="project-year recruiter-dev infra-only">{project.year}</span>
    </div>
  </div>

  <h3 class="featured-card-name">{project.name}</h3>
  <p class="featured-card-summary">{project.one_line_summary}</p>

  {project.featured_metric && (
    <p class="featured-outcome">{project.featured_metric}</p>
  )}

  <div class="stack-chips featured-chips">
    {project.tech.map(t => (
      <span class="stack-chip">{t}</span>
    ))}
  </div>

  <details class="proj-details featured-details">
    <summary class="proj-details-summary">
      <span>How it was built</span>
      <i class="ti ti-chevron-down" aria-hidden="true"></i>
    </summary>
    <ul class="featured-bullets">
      {project.bullets.map(bullet => (
        <li data-audience={bullet.audience.join(',')}>{bullet.text}</li>
      ))}
    </ul>
  </details>

  {project.why_i_built_it && (
    <div class="callout curious-only">
      <p class="why-text">{project.why_i_built_it}</p>
    </div>
  )}

  <div class="featured-card-footer">
    {!isPrivate ? (
      <a
        href={project.github}
        target="_blank"
        rel="noopener noreferrer"
        class="github-link dev-only infra-only"
        aria-label={`View ${project.name} on GitHub`}
      >
        <i class="ti ti-brand-github"></i>
        <span>View repo</span>
      </a>
    ) : (
      <span class="private-repo dev-only infra-only">
        <i class="ti ti-lock"></i>
        <span>Private repo</span>
      </span>
    )}
  </div>
</div>

<style is:global>
  [data-mode="recruiter"] .featured-bullets li[data-audience]:not([data-audience*="recruiter"]):not([data-audience*="management"]) {
    display: none;
  }
  [data-mode="developer"] .featured-bullets li[data-audience]:not([data-audience*="developer"]) { display: none; }
  [data-mode="curious"]   .featured-bullets li[data-audience]:not([data-audience*="curious"])   { display: none; }
  [data-mode="infrastructure"] .featured-bullets li[data-audience]:not([data-audience*="infrastructure"]) { display: none; }

  .featured-card.show-in-infrastructure { display: none; }
  [data-mode="infrastructure"] .featured-card.show-in-infrastructure { display: block; }
  [data-mode="infrastructure"] .featured-card.hide-in-infrastructure { display: none; }
</style>

<style>
.featured-outcome {
  font-family: var(--font-display);
  font-size: var(--text-xl);
  line-height: 1.3;
  color: var(--cat-color, var(--accent-text));
  margin: 0 0 var(--space-4);
  text-wrap: balance;
}
.featured-chips { margin-bottom: var(--space-4); }
.featured-details { border-top: 1px solid var(--border); padding-top: var(--space-3); }
.featured-details .featured-bullets { padding-top: var(--space-3); }

.featured-card {
  background: var(--surface);
  border: 1px solid var(--border);
  border-left: 3px solid var(--cat-border, var(--border));
  border-radius: var(--card-radius);
  padding: var(--space-8);
  margin-bottom: var(--space-6);
  transition: border-color var(--motion-base);
}
.featured-card:hover {
  border-color: var(--border-strong);
}
.featured-card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: var(--space-3);
  margin-bottom: var(--space-4);
}
.featured-card-meta {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  flex-wrap: wrap;
}
.featured-badge {
  font-family: var(--font-mono);
  font-size: 10px;
  letter-spacing: 0.10em;
  text-transform: uppercase;
  background: var(--accent-subtle);
  color: var(--accent-text);
  border: 1px solid var(--accent-border);
  border-radius: var(--radius-sm);
  padding: 2px 8px;
}
.project-tagline {
  font-family: var(--font-mono);
  font-size: var(--text-xs);
  color: var(--text-muted);
  letter-spacing: 0.04em;
}
.project-year {
  font-family: var(--font-mono);
  font-size: var(--text-xs);
  color: var(--text-disabled);
}
.featured-card-name {
  font-family: var(--font-display);
  font-size: var(--text-2xl);
  font-weight: 400;
  color: var(--text);
  letter-spacing: -0.02em;
  line-height: 1.2;
  margin: 0 0 var(--space-3);
  font-optical-sizing: auto;
}
.featured-card-summary {
  font-size: var(--text-base);
  color: var(--text-muted);
  line-height: 1.7;
  margin-bottom: var(--space-5);
}
.featured-bullets {
  list-style: disc;
  padding-left: var(--space-5);
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
  margin-bottom: var(--space-5);
  font-size: var(--text-sm);
  color: var(--text-muted);
  line-height: 1.7;
}
.featured-card-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: var(--space-4);
  margin-top: var(--space-5);
  padding-top: var(--space-4);
  border-top: 1px solid var(--border);
}
.stack-chips {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-2);
}
.github-link,
.private-repo {
  display: inline-flex;
  align-items: center;
  gap: var(--space-2);
  font-family: var(--font-mono);
  font-size: var(--text-xs);
  color: var(--accent-text);
  text-decoration: none;
  transition: color var(--motion-fast);
}
.github-link:hover {
  text-decoration: underline;
}
.private-repo {
  color: var(--text-disabled);
  font-style: italic;
}
.why-text {
  font-size: var(--text-sm);
  color: var(--text-muted);
  line-height: 1.75;
  font-style: italic;
  margin: 0;
}
</style>
