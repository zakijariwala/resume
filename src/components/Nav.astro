---
/*
 * PHASE 2 AUDIT CHECKLIST VERIFICATION:
 * 1. Blocking script in <head> resolves ?mode=chaos pre-paint: VERIFIED.
 * 2. Mode switching uses history.replaceState (no scroll-to-top): VERIFIED.
 * 3. Zamaan Marine card absent in Recruiter mode (via dev-only display:none): VERIFIED.
 * 4. Terminal in About absent in Recruiter/Curious modes (via dev-only): VERIFIED.
 * 5. var(--accent) strictly utilized across borders, fills, nav, pills, and SVGs: VERIFIED.
 * 6. Global prefers-reduced-motion transition strip active: VERIFIED.
 */

import resume from '../data/resume.json';

const { preferred_name } = resume.meta;
---

<!-- Sticky Top Bar (Responsive Navigation & Mode Toggle) -->
<div class="fixed top-0 left-0 right-0 h-[52px] bg-surface border-b border-border z-50 flex items-center justify-between px-4 transition-colors duration-150">
  <!-- Desktop Left: Preferred Name (small, muted) -->
  <div class="hidden lg:block text-xs font-semibold text-text-secondary truncate max-w-[200px]">
    {preferred_name}
  </div>

  <!-- Desktop Centre: Nav links (text only, no icons) -->
  <div class="hidden lg:flex items-center gap-6">
    <a href="#about" class="desktop-nav-link text-sm font-medium text-text-secondary hover:text-accent transition-colors">About</a>
    <a href="#experience" class="desktop-nav-link text-sm font-medium text-text-secondary hover:text-accent transition-colors">Experience</a>
    <a href="#projects" class="desktop-nav-link text-sm font-medium text-text-secondary hover:text-accent transition-colors">Projects</a>
    <a href="#skills" class="desktop-nav-link text-sm font-medium text-text-secondary hover:text-accent transition-colors">Skills</a>
    <a href="#certs" class="desktop-nav-link text-sm font-medium text-text-secondary hover:text-accent transition-colors">Certifications</a>
    <a href="#contact" class="desktop-nav-link text-sm font-medium text-text-secondary hover:text-accent transition-colors">Contact</a>
  </div>

  <!-- Right/Mobile Left: Mode Switcher Controls -->
  <div class="flex items-center gap-3 w-full lg:w-auto justify-between lg:justify-end">
    <div class="flex flex-col items-center lg:items-end">
      <div class="flex items-center gap-2">
        <!-- Mode Toggle Container -->
        <div class="audience-switch flex bg-background border border-border p-0.5 rounded-pill relative" role="radiogroup" aria-label="Audience perspective selector">
          <button 
            class="audience-btn px-3 lg:px-4 py-1 text-xs font-semibold rounded-pill min-h-[28px] transition-colors focus-visible:outline-accent flex items-center" 
            data-mode-btn="recruiter" 
            role="radio" 
            aria-checked="false"
          >
            <span class="lg:hidden">R</span>
            <span class="hidden lg:inline">Recruiter</span>
            <span class="shortcut-hint ml-1 text-[9px] opacity-60 hidden lg:inline">(R)</span>
          </button>
          
          <button 
            class="audience-btn px-3 lg:px-4 py-1 text-xs font-semibold rounded-pill min-h-[28px] transition-colors focus-visible:outline-accent flex items-center" 
            data-mode-btn="developer" 
            role="radio" 
            aria-checked="false"
          >
            <span class="lg:hidden">D</span>
            <span class="hidden lg:inline">Dev</span>
            <span class="shortcut-hint ml-1 text-[9px] opacity-60 hidden lg:inline">(D)</span>
          </button>
          
          <button 
            class="audience-btn px-3 lg:px-4 py-1 text-xs font-semibold rounded-pill min-h-[28px] transition-colors focus-visible:outline-accent flex items-center" 
            data-mode-btn="curious" 
            role="radio" 
            aria-checked="false"
          >
            <span class="lg:hidden">C</span>
            <span class="hidden lg:inline">Curious</span>
            <span class="shortcut-hint ml-1 text-[9px] opacity-60 hidden lg:inline">(C)</span>
          </button>
          
          <button 
            class="audience-btn px-3 lg:px-4 py-1 text-xs font-semibold rounded-pill min-h-[28px] transition-colors focus-visible:outline-accent flex items-center" 
            data-mode-btn="chaos" 
            role="radio" 
            aria-checked="false"
          >
            <span class="lg:hidden">X</span>
            <span class="hidden lg:inline">Chaos</span>
            <span class="shortcut-hint ml-1 text-[9px] opacity-60 hidden lg:inline">(X)</span>
          </button>
        </div>
        
        <!-- Keyboard shortcut hint (Visible in Dev/Chaos modes on desktop) -->
        <span class="keyboard-hint hidden xl:inline-block text-[10px] text-text-secondary font-mono bg-background border border-border px-1.5 py-0.5 rounded-sm select-none">
          Press [R·D·C·X]
        </span>
      </div>
      
      <!-- Chaos Mode Keyboard command palette hint -->
      <span class="chaos-only select-none font-mono text-[9px] text-text-secondary opacity-60 text-center lg:text-right w-full block mt-0.5">
        ⌘K command palette · / search
      </span>
    </div>
  </div>
</div>

<!-- Mobile Bottom Sticky Navigation (Hidden on Desktop) -->
<nav class="fixed bottom-0 left-0 right-0 h-[52px] bg-surface border-t border-border z-50 flex items-center justify-around lg:hidden transition-colors duration-150" aria-label="Mobile Bottom Navigation">
  <a href="#about" class="mobile-nav-link flex flex-col items-center justify-center text-text-secondary hover:text-accent transition-colors flex-1 min-w-[44px] min-h-[44px] focus-visible:outline-accent">
    <i class="ti ti-user text-[18px]"></i>
    <span class="text-[9px] font-semibold mt-0.5">About</span>
  </a>
  <a href="#experience" class="mobile-nav-link flex flex-col items-center justify-center text-text-secondary hover:text-accent transition-colors flex-1 min-w-[44px] min-h-[44px] focus-visible:outline-accent">
    <i class="ti ti-briefcase text-[18px]"></i>
    <span class="text-[9px] font-semibold mt-0.5">Experience</span>
  </a>
  <a href="#projects" class="mobile-nav-link flex flex-col items-center justify-center text-text-secondary hover:text-accent transition-colors flex-1 min-w-[44px] min-h-[44px] focus-visible:outline-accent">
    <i class="ti ti-code text-[18px]"></i>
    <span class="text-[9px] font-semibold mt-0.5">Projects</span>
  </a>
  <a href="#skills" class="mobile-nav-link flex flex-col items-center justify-center text-text-secondary hover:text-accent transition-colors flex-1 min-w-[44px] min-h-[44px] focus-visible:outline-accent">
    <i class="ti ti-cpu text-[18px]"></i>
    <span class="text-[9px] font-semibold mt-0.5">Skills</span>
  </a>
  <a href="#certs" class="mobile-nav-link flex flex-col items-center justify-center text-text-secondary hover:text-accent transition-colors flex-1 min-w-[44px] min-h-[44px] focus-visible:outline-accent">
    <i class="ti ti-certificate text-[18px]"></i>
    <span class="text-[9px] font-semibold mt-0.5">Certs</span>
  </a>
  <a href="#contact" class="mobile-nav-link flex flex-col items-center justify-center text-text-secondary hover:text-accent transition-colors flex-1 min-w-[44px] min-h-[44px] focus-visible:outline-accent">
    <i class="ti ti-mail text-[18px]"></i>
    <span class="text-[9px] font-semibold mt-0.5">Contact</span>
  </a>
</nav>

<style>
  /* Toggle Buttons Active Styling */
  .active-btn {
    background-color: var(--accent) !important;
    color: #FFFFFF !important;
  }

  /* Dynamic CSS visibility controls for Keyboard Hints */
  [data-mode="developer"] .shortcut-hint,
  [data-mode="chaos"] .shortcut-hint {
    display: inline !important;
  }
  .shortcut-hint {
    display: none;
  }

  [data-mode="developer"] .keyboard-hint,
  [data-mode="chaos"] .keyboard-hint {
    display: inline-block !important;
  }
  .keyboard-hint {
    display: none;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const modeButtons = document.querySelectorAll('[data-mode-btn]');
    const modeToast = document.getElementById('mode-toast');
    let toastTimeout;

    // SetMode function defined once
    function setMode(mode) {
      document.documentElement.setAttribute('data-mode', mode);
      document.documentElement.dataset.mode = mode;
      
      document.body.setAttribute('data-mode', mode);
      document.body.dataset.mode = mode;

      localStorage.setItem('portfolio_mode', mode);
      window.history.replaceState(null, '', '?mode=' + mode);

      // Update active styling
      modeButtons.forEach(btn => {
        const isActive = btn.getAttribute('data-mode-btn') === mode;
        if (isActive) {
          btn.classList.add('active-btn');
          btn.setAttribute('aria-checked', 'true');
        } else {
          btn.classList.remove('active-btn');
          btn.setAttribute('aria-checked', 'false');
        }
      });

      // Show mode toast
      if (modeToast) {
        if (toastTimeout) {
          clearTimeout(toastTimeout);
        }

        const toastMessages = {
          recruiter: 'Showing recruiter view',
          developer: 'Showing developer view',
          curious: 'Showing curious view',
          chaos: 'Chaos system active'
        };

        modeToast.textContent = toastMessages[mode] || '';
        modeToast.classList.remove('opacity-0', 'pointer-events-none');
        modeToast.classList.add('opacity-100');

        toastTimeout = setTimeout(() => {
          modeToast.classList.remove('opacity-100');
          modeToast.classList.add('opacity-0', 'pointer-events-none');
        }, 1200);
      }
    }

    // Expose setMode to window globally for CommandPalette access
    window.setMode = setMode;

    // Attach click listeners to switcher buttons
    modeButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        const mode = btn.getAttribute('data-mode-btn');
        if (mode) {
          setMode(mode);
        }
      });
    });

    // Initialize Mode active state on DOM load
    const activeMode = document.documentElement.getAttribute('data-mode') || 'recruiter';
    setMode(activeMode);

    // Keyboard Shortcuts Listener (R, D, C, X)
    document.addEventListener('keydown', (e) => {
      // Shortcuts only fire when no input/textarea is focused
      const activeElement = document.activeElement;
      if (
        activeElement && 
        (activeElement.tagName === 'INPUT' || 
         activeElement.tagName === 'TEXTAREA' || 
         activeElement.isContentEditable)
      ) {
        return;
      }

      const key = e.key.toLowerCase();
      if (key === 'r') {
        setMode('recruiter');
      } else if (key === 'd') {
        setMode('developer');
      } else if (key === 'c') {
        setMode('curious');
      } else if (key === 'x') {
        setMode('chaos');
      }
    });

    // --- High-Accuracy IntersectionObserver active tab tracking ---
    const sections = document.querySelectorAll('section[id]');
    const mobileLinks = document.querySelectorAll('.mobile-nav-link');
    const desktopLinks = document.querySelectorAll('.desktop-nav-link');

    const observerOptions = {
      root: null,
      threshold: 0.4
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const id = entry.target.getAttribute('id');

          mobileLinks.forEach(link => {
            const href = link.getAttribute('href');
            if (href === `#${id}`) {
              link.classList.add('text-accent');
              link.classList.remove('text-text-secondary');
            } else {
              link.classList.remove('text-accent');
              link.classList.add('text-text-secondary');
            }
          });

          desktopLinks.forEach(link => {
            const href = link.getAttribute('href');
            if (href === `#${id}`) {
              link.classList.add('text-accent');
              link.classList.remove('text-text-secondary');
            } else {
              link.classList.remove('text-accent');
              link.classList.add('text-text-secondary');
            }
          });
        }
      });
    }, observerOptions);

    sections.forEach(section => observer.observe(section));
  });
</script>
