---
import meta from '../data/meta.json';

const { name } = meta;
const resumeHref = meta.pdf_path;

// The switcher is a set of page links now, not a radio group: Developer,
// Curious and Infrastructure are separate routes. Mark the current one.
const norm = (u: string) => u.replace(/\/+$/, '') || '/';
const path = norm(Astro.url.pathname);
const isCurrent = (href: string) => path === norm(href);
const isNow = Astro.url.pathname.replace(/\/$/, '').endsWith('/now');
---

<!-- Desktop top nav -->
<header
  class="fixed top-0 left-0 right-0 z-50 flex items-center justify-center lg:justify-between px-6 transition-colors duration-150"
  style="height: var(--nav-height); background: var(--nav-bg); border-bottom: 1px solid var(--border); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);"
>
  <!-- Logo / name -->
  <a
    href="#hero"
    class="hidden lg:block font-body text-sm font-semibold truncate max-w-[200px] transition-colors duration-150"
    style="color: var(--text);"
    aria-label="Back to top"
  >
    {name}
  </a>

  <!-- Desktop nav links -->
  <nav class="hidden lg:flex items-center gap-5" aria-label="Main navigation">
    <a href="#about" class="desktop-nav-link nav-link">About</a>
    <a href="#experience" class="desktop-nav-link nav-link">Work</a>
    <a href="#projects" class="desktop-nav-link nav-link">Projects</a>
    <a href="#thinking" class="desktop-nav-link nav-link">Thinking</a>
    <a href="#contact" class="desktop-nav-link nav-link">Contact</a>
    <a href="/now" class:list={['nav-link lab-nav-link', { active: isNow }]}>
      <i class="ti ti-flask" aria-hidden="true"></i>
      Now
    </a>
    <a href={resumeHref} download class="nav-resume">Résumé</a>
  </nav>

  <!-- Right controls: mode switcher + theme toggle -->
  <div class="flex items-center gap-3">
    <!-- Mode switcher with label + coachmark -->
    <div class="mode-switch-wrapper">
      <span class="mode-switch-label" id="mode-switch-label">Viewing as</span>
      <div
        class="audience-switch flex p-0.5 rounded-full"
        style="background: var(--bg); border: 1px solid var(--border);"
        aria-label="Select audience perspective"
      >
        <a
          href="/"
          class={`audience-btn audience-btn--link ${isCurrent('/') ? 'active' : ''}`}
          aria-current={isCurrent('/') ? 'page' : undefined}
        >Recruiter</a>
        <a
          href="/dev"
          class={`audience-btn audience-btn--link ${isCurrent('/dev') ? 'active' : ''}`}
          aria-current={isCurrent('/dev') ? 'page' : undefined}
        >Developer</a>
        <a
          href="/infra"
          class={`audience-btn audience-btn--link ${isCurrent('/infra') ? 'active' : ''}`}
          aria-current={isCurrent('/infra') ? 'page' : undefined}
        >Infra</a>
        <a
          href="/curious"
          class={`audience-btn audience-btn--link ${isCurrent('/curious') ? 'active' : ''}`}
          aria-current={isCurrent('/curious') ? 'page' : undefined}
        >Curious</a>
      </div>
      <div id="mode-coachmark" class="mode-coachmark" aria-hidden="true">
        <span>This site has 4 perspectives — try switching</span>
        <button class="coachmark-close" id="coachmark-close" aria-label="Dismiss hint">×</button>
      </div>
    </div>

    <!-- Theme toggle -->
    <button
      class="theme-toggle-btn w-8 h-8 rounded-full flex items-center justify-center transition-colors duration-150"
      style="border: 1px solid var(--border); background: var(--surface);"
      aria-label="Toggle light/dark theme"
    >
      <i class="ti ti-moon text-base" id="theme-icon" style="color: var(--text);"></i>
    </button>
  </div>
</header>

<!-- Mobile bottom nav -->
<nav
  class="fixed bottom-0 left-0 right-0 z-50 flex items-center justify-around lg:hidden"
  style="height: var(--nav-height); background: var(--nav-bg); border-top: 1px solid var(--border); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);"
  aria-label="Mobile navigation"
>
  <a href="#about" class="mobile-nav-link mob-link"><i class="ti ti-user text-lg"></i><span>About</span></a>
  <a href="#experience" class="mobile-nav-link mob-link"><i class="ti ti-briefcase text-lg"></i><span>Work</span></a>
  <a href="#projects" class="mobile-nav-link mob-link"><i class="ti ti-code text-lg"></i><span>Projects</span></a>
  <a href="#skills" class="mobile-nav-link mob-link"><i class="ti ti-cpu text-lg"></i><span>Skills</span></a>
  <a href="#contact" class="mobile-nav-link mob-link"><i class="ti ti-mail text-lg"></i><span>Contact</span></a>
  <a href="/now" class:list={['mob-link', { active: isNow }]}><i class="ti ti-flask text-lg"></i><span>Now</span></a>
</nav>

<style>
.nav-link {
  font-family: var(--font-body);
  font-size: 13px;
  font-weight: 500;
  color: var(--text-muted);
  text-decoration: none;
  transition: color var(--motion-fast);
}
.nav-link:hover,
.nav-link.active { color: var(--accent); }
.nav-link:focus-visible,
.nav-resume:focus-visible {
  outline: 2px solid var(--accent);
  outline-offset: 3px;
  border-radius: var(--radius-xs);
}

.nav-resume {
  font-family: var(--font-body);
  font-size: 13px;
  font-weight: 600;
  color: var(--accent-text);
  border: 1px solid var(--accent-border);
  background: var(--accent-subtle);
  border-radius: 9999px;
  padding: 4px 12px;
  text-decoration: none;
  white-space: nowrap;
  transition: background var(--motion-fast), color var(--motion-fast);
}
.nav-resume:hover { background: var(--accent); color: #fff; }

.lab-nav-link {
  display: inline-flex;
  align-items: center;
  gap: 4px;
}
.lab-nav-link i { font-size: 13px; }

.audience-btn {
  padding: 2px 12px;
  white-space: nowrap;
  font-family: var(--font-body);
  font-size: 11px;
  font-weight: 600;
  color: var(--text-muted);
  border-radius: 9999px;
  min-height: 26px;
  border: none;
  background: transparent;
  cursor: pointer;
  transition: color var(--motion-fast), background var(--motion-fast);
}
.audience-btn:hover { color: var(--text); }
.audience-btn--link { text-decoration: none; }
.audience-btn.active {
  background: var(--accent);
  color: #fff;
}
.audience-btn:focus-visible {
  outline: 2px solid var(--accent);
  outline-offset: 2px;
}

@media (max-width: 480px) {
  .audience-btn { padding: 2px 8px; font-size: 10px; }
}

.mob-link {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex: 1;
  padding: 4px 0;
  font-family: var(--font-body);
  font-size: 10px;
  font-weight: 600;
  color: var(--text-muted);
  text-decoration: none;
  gap: 2px;
  transition: color var(--motion-fast);
}
.mob-link:hover,
.mob-link.active { color: var(--accent); }

.mode-switch-wrapper {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  position: relative;
}
.mode-switch-label {
  font-family: var(--font-mono);
  font-size: 10px;
  font-weight: 700;
  color: #fff;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  white-space: nowrap;
  border-radius: 9999px;
  padding: 3px 10px;
  background: var(--attention);
  animation: heartbeat-halo 1.3s ease-in-out infinite 3s;
  animation-fill-mode: both;
  will-change: box-shadow, transform;
}
@keyframes heartbeat-halo {
  0%   { box-shadow: 0 0 0 0 var(--attention-glow);      transform: scale(1); }
  12%  { box-shadow: 0 0 0 8px var(--attention-glow-soft); transform: scale(1.06); }
  24%  { box-shadow: 0 0 0 0 var(--attention-glow);      transform: scale(1); }
  44%  { box-shadow: 0 0 0 13px var(--attention-glow-soft); transform: scale(1.06); }
  60%  { box-shadow: 0 0 0 0 var(--attention-glow-soft); transform: scale(1); }
  100% { box-shadow: 0 0 0 0 var(--attention-glow-soft); transform: scale(1); }
}
@media (prefers-reduced-motion: reduce) {
  .mode-switch-label {
    animation: none;
    box-shadow: 0 0 0 3px var(--attention-glow);
  }
}
.mode-coachmark {
  position: absolute;
  top: calc(100% + 10px);
  right: 0;
  background: var(--surface-raised);
  border: 1px solid var(--border-strong);
  border-radius: var(--radius-sm);
  padding: var(--space-2) var(--space-4);
  font-family: var(--font-body);
  font-size: var(--text-xs);
  color: var(--text-muted);
  white-space: nowrap;
  display: flex;
  align-items: center;
  gap: var(--space-3);
  z-index: 100;
  animation: coachmark-in 0.25s ease both;
  animation-delay: 1.2s;
  opacity: 0;
}
.mode-coachmark::before {
  content: '';
  position: absolute;
  top: -5px;
  right: 28px;
  width: 8px;
  height: 8px;
  background: var(--surface-raised);
  border-left: 1px solid var(--border-strong);
  border-top: 1px solid var(--border-strong);
  transform: rotate(45deg);
}
.mode-coachmark.hidden { display: none; }
@keyframes coachmark-in {
  from { opacity: 0; transform: translateY(-4px); }
  to   { opacity: 1; transform: translateY(0); }
}
.coachmark-close {
  background: none;
  border: none;
  color: var(--text-disabled);
  cursor: pointer;
  font-size: 16px;
  line-height: 1;
  padding: 0 0 0 var(--space-1);
  transition: color var(--motion-fast);
}
.coachmark-close:hover { color: var(--text); }
</style>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const modeButtons = document.querySelectorAll<HTMLButtonElement>('[data-mode-btn]');
  const toast = document.getElementById('mode-toast');
  let toastTimer: ReturnType<typeof setTimeout> | undefined;

  // Coachmark — appears every new session until the visitor interacts
  // with the mode pill. Interacting with the pill dismisses it for good;
  // the close button only hides it for the current view.
  const coachmark = document.getElementById('mode-coachmark');
  const coachmarkClose = document.getElementById('coachmark-close');

  function hideCoachmark() {
    if (coachmark) coachmark.classList.add('hidden');
  }

  // Permanent dismiss only after the visitor has used the switcher.
  if (localStorage.getItem('portfolio_mode_interacted')) {
    hideCoachmark();
  }
  if (coachmarkClose) {
    coachmarkClose.addEventListener('click', hideCoachmark);
  }

  function setMode(mode: string) {
    document.documentElement.setAttribute('data-mode', mode);
    document.body.setAttribute('data-mode', mode);
    localStorage.setItem('portfolio_mode', mode);
    window.history.replaceState(null, '', '?mode=' + mode);

    modeButtons.forEach(btn => {
      const active = btn.dataset.modeBtn === mode;
      btn.classList.toggle('active', active);
      btn.setAttribute('aria-checked', active ? 'true' : 'false');
    });

    if (toast) {
      clearTimeout(toastTimer);
      const labels: Record<string, string> = {
        recruiter: 'Recruiter view',
        developer: 'Developer view',
        infrastructure: 'Infrastructure view',
        curious: 'Curious view',
      };
      toast.textContent = labels[mode] ?? '';
      toast.classList.remove('opacity-0');
      toast.classList.add('opacity-100');
      toastTimer = setTimeout(() => {
        toast.classList.remove('opacity-100');
        toast.classList.add('opacity-0');
      }, 1400);
    }

    window.dispatchEvent(new CustomEvent('portfolio-mode-change', { detail: { mode } }));
  }

  modeButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      const mode = btn.dataset.modeBtn;
      if (mode) {
        localStorage.setItem('portfolio_mode_interacted', '1');
        hideCoachmark();
        setMode(mode);
      }
    });
  });

  const initialMode = document.documentElement.getAttribute('data-mode') || 'recruiter';
  setMode(initialMode);

  // Theme toggle
  const themeBtn = document.querySelector<HTMLButtonElement>('.theme-toggle-btn');
  const themeIcon = document.getElementById('theme-icon');

  function syncThemeIcon(theme: string) {
    if (themeIcon) {
      themeIcon.className = theme === 'dark'
        ? 'ti ti-sun text-base'
        : 'ti ti-moon text-base';
    }
  }

  function toggleTheme() {
    const current = document.documentElement.getAttribute('data-theme') || 'light';
    const next = current === 'dark' ? 'light' : 'dark';
    document.documentElement.setAttribute('data-theme', next);
    document.body.setAttribute('data-theme', next);
    localStorage.setItem('portfolio_theme', next);
    syncThemeIcon(next);
  }

  if (themeBtn) themeBtn.addEventListener('click', toggleTheme);
  syncThemeIcon(document.documentElement.getAttribute('data-theme') || 'light');

  // Active nav link tracker
  const sections = document.querySelectorAll<HTMLElement>('section[id]');
  const desktopLinks = document.querySelectorAll<HTMLAnchorElement>('.desktop-nav-link');
  const mobileLinks = document.querySelectorAll<HTMLAnchorElement>('.mobile-nav-link');

  const navObserver = new IntersectionObserver(entries => {
    entries.forEach(entry => {
      if (!entry.isIntersecting) return;
      const id = entry.target.getAttribute('id');
      [...desktopLinks, ...mobileLinks].forEach(link => {
        const matches = link.getAttribute('href') === `#${id}`;
        link.classList.toggle('active', matches);
      });
    });
  }, { threshold: 0.4 });

  sections.forEach(s => navObserver.observe(s));
});
</script>
