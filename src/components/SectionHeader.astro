---
interface Props {
  label?: string;
  labelDev?: string;
  labelCurious?: string;
  labelInfra?: string;
  title: string;
  hideLabel?: boolean;
}

const { label = '', labelDev, labelCurious, labelInfra, title, hideLabel = false } = Astro.props;
const hasModeLabels = labelDev || labelCurious || labelInfra;
---

<div class="section-header fade-in">
  {!hideLabel && (
    <div class="section-label">
      {hasModeLabels ? (
        <>
          <span class="recruiter-only">{label}</span>
          <span class="dev-only">{labelDev ?? label}</span>
          <span class="curious-only">{labelCurious ?? label}</span>
          <span class="infra-only">{labelInfra ?? label}</span>
        </>
      ) : label}
    </div>
  )}
  <h2 class="section-title">{title}</h2>
</div>
