---
import resume from '../data/resume.json';

const certificationsData = resume.certifications;
---

<section id="certifications" class="certs-section py-12 border-b border-border transition-all duration-300">
  <!-- Section Heading -->
  <h2 class="text-2xl font-serif text-text-primary mb-6 relative inline-block">
    Certifications
    <span class="absolute bottom-[-6px] left-0 w-8 h-[2px] bg-accent transition-colors duration-150"></span>
  </h2>

  <!-- Editorial Row List -->
  <div class="certifications-list divide-y divide-border/50 border-t border-b border-border/30">
    {certificationsData.map(cert => {
      const isProgress = cert.status === 'in_progress';
      
      return (
        <div class={`py-4 flex flex-col gap-2 ${isProgress ? 'dev-only curious-only' : 'all-modes'}`}>
          <div class="flex items-start justify-between gap-4">
            <!-- Left Side: Credentials Identity -->
            <div class="flex-1 min-w-0 select-text">
              <h3 class="text-sm font-semibold text-text-primary leading-tight">
                {cert.name}
              </h3>
              <p class="text-xs text-text-secondary mt-1">
                {cert.issuer} &bull; {cert.year}
              </p>
            </div>
            
            <!-- Right Side: Status Badge -->
            <div class="flex items-center justify-end select-none">
              {cert.status === 'completed' ? (
                <span class="text-[11px] font-semibold px-2 py-0.5 rounded-[30px] bg-[#D1FAE5] text-[#065F46] border border-[#D1FAE5]/10 whitespace-nowrap uppercase tracking-wider">
                  Completed
                </span>
              ) : (
                <span class="text-[11px] font-semibold px-2 py-0.5 rounded-[30px] bg-[#FEF3C7] text-[#92400E] border border-[#FEF3C7]/10 whitespace-nowrap uppercase tracking-wider">
                  In Progress
                </span>
              )}
            </div>
          </div>
          
          <!-- Special Notes (dev-only curious-only) -->
          {cert.note && (
            <div class="dev-only curious-only mt-0.5 select-text">
              <p class="text-[12px] text-text-secondary italic pl-3 border-l border-accent/40 leading-relaxed">
                {cert.note}
              </p>
            </div>
          )}
        </div>
      );
    })}
  </div>
</section>

<style is:global>
  /* Curious Mode hides certifications section entirely */
  [data-mode="curious"] .certs-section {
    display: none !important;
  }
</style>
