---
import resume from '../data/resume.json';
import ExperienceCard from './ExperienceCard.astro';
---

<section id="experience" class="py-12 border-b border-border transition-all duration-300">
  <!-- Section Heading -->
  <h2 class="text-2xl font-serif text-text-primary mb-6 relative inline-block">
    Experience
    <span class="absolute bottom-[-6px] left-0 w-8 h-[2px] bg-accent transition-colors duration-150"></span>
  </h2>

  <!-- Experience Timeline / List Wrapper -->
  <div class="exp-section transition-all duration-300">
    {resume.experience.map(entry => (
      <ExperienceCard entry={entry} />
    ))}
  </div>
</section>

<style is:global>
  /* Curious Mode Timeline Wrapper Styles */
  [data-mode="curious"] .exp-section {
    border-left: 2px solid var(--accent) !important;
    padding-left: 24px !important;
    margin-left: 8px !important;
    display: flex !important;
    flex-direction: column !important;
    gap: 32px !important;
  }
</style>
