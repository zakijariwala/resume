---
import experience from '../../data/experience.json';
import certifications from '../../data/certifications.json';
import meta from '../../data/meta.json';

const { education } = meta;

// One condensed line per role for this layout; full detail lives in the resume PDF.
const summaries: Record<string, string> = {
  tcs: 'Leading a five-engineer ops team on Tier-1 banking identity infrastructure. 99.999% availability for 30,000+ users, disaster-recovery time cut in half, containerisation shipped inside RBI compliance walls.',
  coaching: 'Founded a practice teaching 50+ engineers and managers to explain their work to people who are not engineers. Harder than it sounds, more technical than it looks.',
};
---

<section class="aexp wrap" id="experience">
  <h2 class="h-giant rv">Experience</h2>

  <div class="aexp-rows">
    {experience.map((entry) => (
      <div class="aexp-row rv">
        <div class="aexp-head">
          <h3 class="aexp-co">{entry.company}</h3>
          <span class="aexp-dates mono-label">{entry.dates.replace(/–/g, '-')}</span>
        </div>
        <p class="aexp-role">{entry.title}</p>
        {entry.subtitle && <p class="aexp-subtitle">{entry.subtitle}</p>}
        <p class="aexp-summary">{summaries[entry.id]}</p>
        <div class="aexp-kpis">
          {entry.kpis.map(kpi => (
            <div class="aexp-kpi">
              <span class="aexp-kpi-val" data-count>{kpi.value}</span>
              <span class="aexp-kpi-label">{kpi.label}</span>
            </div>
          ))}
        </div>
      </div>
    ))}
  </div>

  <div class="aexp-certs rv">
    {certifications.map(cert => (
      <div class="aexp-cert">
        <span class="aexp-cert-name">{cert.name}</span>
        <span class="aexp-cert-meta mono-label">
          {cert.issuer} · {cert.status === 'in_progress' ? `in progress, ${cert.year}` : cert.year}
        </span>
      </div>
    ))}
    {education && (
      <div class="aexp-cert">
        <span class="aexp-cert-name">{education.degree}</span>
        <span class="aexp-cert-meta mono-label">{education.institution} · {education.year}</span>
      </div>
    )}
  </div>
</section>

<style>
.aexp { padding-block: var(--section-gap); }
.aexp-rows { margin-top: clamp(40px, 6vh, 80px); }

.aexp-row {
  padding: clamp(36px, 5vh, 64px) 0;
  border-top: 1px solid var(--line);
}
.aexp-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 24px;
  flex-wrap: wrap;
}
.aexp-co {
  font-family: var(--font-display);
  font-weight: 700;
  font-size: clamp(26px, 3.2vw, 44px);
  letter-spacing: -0.015em;
  margin: 0;
}
.aexp-role {
  font-family: var(--font-mono);
  font-size: 14px;
  color: var(--accent-deep);
  margin: 12px 0 0;
}
.aexp-subtitle {
  font-size: 14px;
  color: var(--faint);
  margin: 4px 0 0;
}
.aexp-summary {
  font-size: clamp(16px, 1.4vw, 19px);
  line-height: 1.7;
  color: var(--muted);
  max-width: 64ch;
  margin: 20px 0 0;
}
.aexp-kpis {
  display: flex;
  gap: clamp(28px, 4vw, 64px);
  flex-wrap: wrap;
  margin-top: 32px;
}
.aexp-kpi { display: flex; flex-direction: column; gap: 4px; }
.aexp-kpi-val {
  font-family: var(--font-mono);
  font-size: clamp(22px, 2.2vw, 32px);
  font-weight: 500;
  color: var(--text);
}
.aexp-kpi-label {
  font-size: 12px;
  color: var(--faint);
}

.aexp-certs {
  margin-top: clamp(48px, 7vh, 88px);
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 1px;
  background: var(--line);
  border: 1px solid var(--line);
  border-radius: var(--r-surface);
  overflow: hidden;
}
.aexp-cert {
  background: var(--bg-2);
  padding: 28px 32px;
  display: flex;
  flex-direction: column;
  gap: 8px;
}
.aexp-cert-name {
  font-family: var(--font-display);
  font-weight: 600;
  font-size: 17px;
  line-height: 1.3;
}
.aexp-cert-meta { text-transform: none; letter-spacing: 0.04em; }

@media (max-width: 768px) {
  .aexp-certs { grid-template-columns: 1fr; }
}
</style>
