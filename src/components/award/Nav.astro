---
interface Props {
  currentMode?: 'curious' | 'developer';
}
const { currentMode = 'curious' } = Astro.props;
---

<header class="anav" id="anav">
  <div class="wrap anav-row">
    <a href="#top" class="anav-mark" aria-label="Back to top">MZJ</a>
    <nav class="anav-links" aria-label="Main navigation">
      <a href="#work" class="anav-link">Work</a>
      <a href="#about" class="anav-link">About</a>
      <a href="#experience" class="anav-link">Experience</a>
      <a href="/now" class="anav-link">Now</a>
    </nav>
    <div class="anav-right">
      <div class="anav-modes" aria-label="Switch audience mode">
        <a href="/?mode=recruiter" class="anav-mode">Recruiter</a>
        <a href="/dev" class="anav-mode">Developer</a>
        <a href="/infra" class="anav-mode">Infra</a>
        <span class="anav-mode anav-mode--active">Curious</span>
      </div>
      <a href="#contact" class="btn btn-ghost anav-cta">Contact</a>
    </div>
  </div>
</header>

<!-- Mobile bottom nav -->
<nav class="anav-mobile" aria-label="Mobile navigation">
  <a href="#work" class="anav-mob-link"><i class="ti ti-briefcase" aria-hidden="true"></i><span>Work</span></a>
  <a href="#about" class="anav-mob-link"><i class="ti ti-user" aria-hidden="true"></i><span>About</span></a>
  <a href="#experience" class="anav-mob-link"><i class="ti ti-timeline" aria-hidden="true"></i><span>Path</span></a>
  <a href="#contact" class="anav-mob-link"><i class="ti ti-mail" aria-hidden="true"></i><span>Contact</span></a>
  <a href="/now" class="anav-mob-link"><i class="ti ti-flask" aria-hidden="true"></i><span>Now</span></a>
</nav>

<style>
.anav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 90;
  height: 68px;
  display: flex;
  align-items: center;
  background: rgba(247, 244, 239, 0.80);
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
  border-bottom: 1px solid var(--line);
}
.anav-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
}
.anav-mark {
  font-family: var(--font-display);
  font-weight: 800;
  font-size: 17px;
  letter-spacing: 0.04em;
  text-decoration: none;
  color: var(--text);
}
.anav-links {
  display: flex;
  align-items: center;
  gap: 32px;
}
.anav-link {
  font-size: 14px;
  font-weight: 500;
  color: var(--muted);
  text-decoration: none;
  transition: color 0.2s ease;
}
.anav-link:hover { color: var(--text); }

.anav-right {
  display: flex;
  align-items: center;
  gap: 16px;
}
.anav-modes {
  display: flex;
  align-items: center;
  gap: 4px;
  background: var(--surface);
  border: 1px solid var(--line-strong);
  border-radius: var(--r-pill);
  padding: 4px;
}
.anav-mode {
  font-family: var(--font-mono);
  font-size: 11px;
  font-weight: 500;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: var(--muted);
  text-decoration: none;
  padding: 5px 12px;
  border-radius: var(--r-pill);
  transition: color 0.2s ease, background 0.2s ease;
}
.anav-mode:hover { color: var(--text); }
.anav-mode--active {
  background: var(--accent);
  color: #fff;
  cursor: default;
}

.anav-cta { padding: 9px 20px; font-size: 13px; }

/* Mobile bottom nav — hidden on desktop */
.anav-mobile { display: none; }

@media (max-width: 768px) {
  .anav-links { display: none; }
  .anav-modes { display: none; }

  .anav-mobile {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 90;
    height: 60px;
    padding-bottom: env(safe-area-inset-bottom, 0);
    display: flex;
    align-items: stretch;
    justify-content: space-around;
    background: rgba(247, 244, 239, 0.92);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-top: 1px solid var(--line-strong);
  }
  .anav-mob-link {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 3px;
    font-family: var(--font-body);
    font-size: 10px;
    font-weight: 600;
    color: var(--muted);
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .anav-mob-link i { font-size: 18px; }
  .anav-mob-link:active { color: var(--accent); }
}
</style>

<style is:global>
@media (max-width: 768px) {
  body { padding-bottom: calc(60px + env(safe-area-inset-bottom, 0)); }
}
</style>
