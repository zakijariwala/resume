---
import thinking from '../../data/thinking.json';
---

<section class="athink wrap" id="thinking">
  <p class="a-label rv">How I decide what to build</p>
  <h2 class="a-h rv">The loop</h2>

  <ol class="athink-list">
    {thinking.map((s, i) => (
      <li class={`athink-step rv cat-${s.cat}`}>
        <span class="athink-idx">{String(i + 1).padStart(2, '0')}</span>
        <h3 class="athink-name">{s.step}</h3>
        <p class="athink-rule">{s.body}</p>
        <p class="athink-evidence">{s.evidence}</p>
        <a class="athink-link" href={`/#project-${s.project_id}`}>{s.project_name} →</a>
      </li>
    ))}
  </ol>
</section>

<style>
.athink { padding-block: var(--section-gap); }
.athink-list {
  list-style: none;
  margin: 0;
  padding: 0;
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: var(--gutter);
}
.athink-step {
  display: flex;
  flex-direction: column;
  gap: 0.6rem;
  padding-top: 1rem;
  border-top: 2px solid var(--cat-border, var(--line-strong));
  min-width: 0;
}
.athink-idx {
  font-family: var(--font-mono);
  font-size: 0.75rem;
  letter-spacing: 0.1em;
  color: var(--cat-color, var(--accent));
}
.athink-name {
  font-family: var(--font-display);
  font-size: 1.5rem;
  font-weight: 600;
  color: var(--text);
  margin: 0;
  line-height: 1.1;
}
.athink-rule { color: var(--muted); margin: 0; }
.athink-evidence {
  color: var(--faint);
  margin: 0;
  font-size: 0.9rem;
  line-height: 1.6;
  padding-top: 0.6rem;
  border-top: 1px solid var(--line);
  margin-top: auto;
}
.athink-link {
  font-family: var(--font-mono);
  font-size: 0.78rem;
  color: var(--cat-color, var(--accent));
  text-decoration: none;
}
.athink-link:hover { text-decoration: underline; }
</style>
