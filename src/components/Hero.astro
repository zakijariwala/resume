---
import meta from '../data/meta.json';

const { name, pdf_path, taglines, hero_subline, whatsapp, currently, availability, photo_url } = meta;
const { hero_eyebrow, hero_statement } = meta;

const modes = ['recruiter', 'developer', 'curious', 'infrastructure'] as const;
const modeClass: Record<string, string> = {
  recruiter: 'recruiter-only',
  developer: 'dev-only',
  curious: 'curious-only',
  infrastructure: 'infra-only',
};

const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
const resolvedPdf = pdf_path.startsWith('http') ? pdf_path : `${basePath}/${pdf_path.replace(/^\//, '')}`;
---

<section id="hero" class="hero-section">
  <!-- Left column: identity + CTAs -->
  <div class="hero-left fade-in">
    <!-- Availability indicator -->
    <div class="availability-line recruiter-only">
      <span class="avail-dot"></span>
      <span class="avail-text">{availability}</span>
    </div>
    <div class="availability-line infra-only">
      <span class="avail-dot"></span>
      <span class="avail-text">{meta.availability_infrastructure}</span>
    </div>

    <p class="hero-eyebrow">
      {modes.map(m => (
        <span class={modeClass[m]}>
          {hero_eyebrow[m].map((part, i) => (
            <>
              {i > 0 && <span class="eyebrow-sep" aria-hidden="true">×</span>}
              <span class={`eyebrow-word cat-${part.cat}`}>{part.word}</span>
            </>
          ))}
        </span>
      ))}
    </p>

    <h1 class="hero-name">{name}</h1>

    <!-- Photo — recruiter mode only, right after name -->
    <div class="hero-photo-wrap recruiter-only fade-in">
      {photo_url ? (
        <img
          src={photo_url}
          alt={`${name} headshot`}
          class="hero-photo"
          width="160"
          height="160"
          loading="eager"
        />
      ) : (
        <div class="hero-photo-placeholder" aria-hidden="true">
          <span class="hero-photo-initials">ZJ</span>
        </div>
      )}
    </div>

    <p class="hero-tagline">
      <span class="recruiter-only">{taglines.recruiter}</span>
      <span class="dev-only">{taglines.developer}</span>
      <span class="curious-only">{taglines.curious}</span>
      <span class="infra-only">{taglines.infrastructure}</span>
    </p>

    <p class="hero-statement">
      {modes.map(m => <span class={modeClass[m]}>{hero_statement[m]}</span>)}
    </p>

    <p class="hero-subline">
      <span class="recruiter-only">{hero_subline.recruiter}</span>
      <span class="dev-only">{hero_subline.developer}</span>
      <span class="curious-only">{hero_subline.curious}</span>
      <span class="infra-only">{hero_subline.infrastructure}</span>
    </p>

    <div class="hero-ctas">
      <a href="#projects" class="btn-primary">
        <i class="ti ti-arrow-down" aria-hidden="true"></i>
        <span>View my work</span>
      </a>
      <a href={resolvedPdf} download class="btn-ghost" aria-label="Download resume PDF">
        <i class="ti ti-download" aria-hidden="true"></i>
        <span>Résumé</span>
      </a>
    </div>
  </div>

  <!-- Right column: mode-adaptive -->
  <div class="hero-right">
    <!-- Curious: personal currently block. Every other mode's numbers live in
         the proof strip below the hero, so they are stated exactly once. -->
    <div class="currently-block curious-only fade-in" style="transition-delay: 0.1s;">
      <div class="currently-label">Currently</div>
      <p class="currently-text">{currently}</p>
    </div>
  </div>
</section>

<style is:global>
.hero-eyebrow > span.recruiter-only,
.hero-eyebrow > span.dev-only,
.hero-eyebrow > span.curious-only,
.hero-eyebrow > span.infra-only { display: none; }
[data-mode="recruiter"] .hero-eyebrow > span.recruiter-only,
[data-mode="developer"] .hero-eyebrow > span.dev-only,
[data-mode="curious"] .hero-eyebrow > span.curious-only,
[data-mode="infrastructure"] .hero-eyebrow > span.infra-only { display: inline-flex; }


/* .availability-line and .stat-grid set their own display value, which
   outranks the .recruiter-only / .recruiter-dev / .infra-only visibility
   classes. Gate them explicitly per mode. These must be global: Astro scopes
   every part of a selector, and [data-mode] sits on <html>, outside this
   component. */
[data-mode="recruiter"] .availability-line.recruiter-only,
[data-mode="infrastructure"] .availability-line.infra-only {
  display: flex;
}
</style>

<style>
.hero-section {
  display: grid;
  /* One column by default: the stat grid moved out to the proof strip, so only
     curious still has a right-hand block to place. */
  grid-template-columns: 1fr;
  gap: var(--space-12);
  align-items: center;
  padding-top: calc(var(--nav-height) + var(--space-8));
  padding-bottom: var(--space-10);
  border-bottom: 1px solid var(--border);
}
:global([data-mode="curious"]) .hero-section {
  grid-template-columns: 1fr 1fr;
}

@media (max-width: 768px) {
  :global([data-mode="curious"]) .hero-section {
    grid-template-columns: 1fr;
  }
  .hero-section {
    grid-template-columns: 1fr;
    padding-top: calc(var(--nav-height) + var(--space-6));
    padding-bottom: var(--space-10);
  }
  .hero-right { order: -1; }
}

.hero-left {
  display: flex;
  flex-direction: column;
  gap: 0;
}
/* The readable measure belongs on the prose, not on the column: constraining
   the column forced the display-size name onto a second line for no reason. */
.hero-statement,
.hero-subline,
.availability-line,
.hero-tagline { max-width: 62ch; }

/* Positioning triad. Each term carries its category colour plus its own word,
   so the meaning survives without colour. */
.hero-eyebrow {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  margin-bottom: var(--space-4);
}
.hero-eyebrow > span {
  align-items: center;
  gap: var(--space-2);
  flex-wrap: wrap;
}
.eyebrow-word {
  font-family: var(--font-mono);
  font-size: var(--text-xs);
  font-weight: 600;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--cat-color, var(--text-muted));
}
.eyebrow-sep {
  font-family: var(--font-mono);
  font-size: var(--text-xs);
  color: var(--text-disabled);
}

.hero-statement {
  font-family: var(--font-display);
  font-size: var(--text-xl);
  font-weight: 400;
  line-height: 1.35;
  color: var(--text);
  margin-top: var(--space-3);
  margin-bottom: var(--space-3);
  text-wrap: balance;
}

.availability-line {
  display: none;
  align-items: center;
  gap: var(--space-2);
  margin-bottom: var(--space-4);
}

.avail-dot {
  width: 8px;
  height: 8px;
  border-radius: 9999px;
  background: var(--status-active-text);
  flex-shrink: 0;
  animation: pulse 2.5s ease-in-out infinite;
}
@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.4; }
}
.avail-text {
  font-family: var(--font-mono);
  font-size: var(--text-xs);
  color: var(--text-muted);
  letter-spacing: 0.04em;
}

.hero-name {
  font-family: var(--font-display);
  font-weight: 400;
  font-size: clamp(36px, 5vw, 56px);
  line-height: 1.1;
  letter-spacing: -0.03em;
  color: var(--text);
  margin: 0 0 var(--space-4);
}
[data-mode="curious"] .hero-name {
  font-style: italic;
  font-size: clamp(40px, 5.5vw, 58px);
}

.hero-tagline {
  font-family: var(--font-mono);
  font-size: var(--text-sm);
  color: var(--accent-text);
  letter-spacing: 0.04em;
  margin: 0 0 var(--space-3);
  min-height: 1.4em;
}

.hero-subline {
  font-family: var(--font-body);
  font-size: var(--text-base);
  color: var(--text-muted);
  line-height: 1.65;
  margin: 0 0 var(--space-8);
  min-height: 1.65em;
}

.hero-ctas {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-3);
  align-items: center;
}

/* Photo — lives in hero-left, below the name */
.hero-photo-wrap {
  display: flex;
  justify-content: flex-start;
  margin-bottom: var(--space-4);
}
.hero-photo {
  width: 64px;
  height: 64px;
  border-radius: 9999px;
  object-fit: cover;
  border: 2px solid var(--border-strong);
  display: block;
}
.hero-photo-placeholder {
  width: 64px;
  height: 64px;
  border-radius: 9999px;
  border: 1px solid var(--border-strong);
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--surface-raised);
}
.hero-photo-initials {
  font-family: var(--font-mono);
  font-size: 13px;
  font-weight: 600;
  letter-spacing: 0.08em;
  color: var(--text-disabled);
}
@media (max-width: 768px) {
  .hero-photo-wrap { margin-bottom: var(--space-3); }
}

/* Stat grid */
.stat-grid {
  display: none;
  grid-template-columns: 1fr 1fr;
  gap: var(--space-3);
}


/* Currently block */
.currently-block {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--card-radius);
  padding: var(--space-6);
}
.currently-label {
  font-family: var(--font-mono);
  font-size: var(--text-xs);
  letter-spacing: 0.10em;
  text-transform: uppercase;
  color: var(--accent-text);
  margin-bottom: var(--space-4);
}
.currently-text {
  font-family: var(--font-body);
  font-size: var(--text-sm);
  color: var(--text-muted);
  line-height: 1.75;
  margin: 0;
}
</style>
