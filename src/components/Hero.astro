---
import resume from '../data/resume.json';

const { preferred_name, pdf_path, email, rep_id } = resume.meta;
const { recruiter, developer, curious } = resume.meta.taglines || {
  recruiter: "Systems Engineer · 3 years · TCS / SBI GITC",
  developer: "Infrastructure + AI automation + whatever I'm building this month",
  curious: "Engineer by day, builder of random things by night"
};

// Split preferred_name into an array of characters for chaos character reveal animation
const nameChars = preferred_name.split('');
---

<section id="hero" class="pt-[96px] pb-[48px] flex flex-col justify-center text-center lg:text-left transition-all duration-300">
  
  <!-- Developer / Chaos Mode REP_ID Label -->
  <div class="dev-only chaos-only mb-2 text-left lg:text-left select-none">
    <span class="font-mono text-[11px] text-text-secondary uppercase tracking-[0.1em]">
      REP_ID: {rep_id}
    </span>
  </div>

  <!-- Name Header with Developer Card Wrap Wrapper -->
  <div class="name-container transition-all duration-300">
    <h1 class="text-3xl lg:text-4xl font-heading font-semibold text-text-primary leading-tight select-text">
      {nameChars.map((char, i) => (
        <span class="chaos-char" style={`animation-delay: ${i * 0.05}s;`}>{char === ' ' ? '\u00A0' : char}</span>
      ))}
    </h1>
    
    <!-- Role taglines (Hides inactive taglines dynamically using CSS visibility tokens) -->
    <p class="text-base font-medium text-text-secondary mt-3 min-h-[24px]">
      <span class="recruiter-only inline-block">{recruiter}</span>
      <span class="dev-only inline-block">{developer}</span>
      <span class="curious-only inline-block">{curious}</span>
    </p>

    <!-- Developer-Only Status Badge -->
    <div class="dev-only mt-3 select-none flex justify-center lg:justify-start">
      <span class="inline-flex items-center gap-1.5 px-3 py-1 text-[11px] font-mono font-semibold bg-[#1A8A5A] text-white rounded-pill tracking-wider uppercase">
        <span class="w-1.5 h-1.5 rounded-full bg-white animate-pulse"></span>
        Status: Available
      </span>
    </div>
  </div>

  <!-- Action Buttons (Pill shaped, 44px min-height targets) -->
  <div class="flex flex-row items-center justify-center lg:justify-start gap-4 mt-8 flex-wrap">
    <a 
      href={pdf_path} 
      download 
      class="btn-action inline-flex items-center justify-center gap-2 min-h-[44px] px-6 py-2 border border-accent text-accent hover:bg-accent hover:text-white rounded-pill transition-all duration-150 text-xs sm:text-sm font-semibold focus-visible:outline-accent whitespace-nowrap"
      aria-label="Download PDF Resume"
    >
      <i class="ti ti-download text-sm sm:text-base" aria-hidden="true"></i>
      <span>Download resume</span>
    </a>
    
    <a 
      href={`mailto:${email}`} 
      class="btn-action inline-flex items-center justify-center gap-2 min-h-[44px] px-6 py-2 border border-accent text-accent hover:bg-accent hover:text-white rounded-pill transition-all duration-150 text-xs sm:text-sm font-semibold focus-visible:outline-accent whitespace-nowrap"
      aria-label="Contact Email"
    >
      <i class="ti ti-mail text-sm sm:text-base" aria-hidden="true"></i>
      <span>Get in touch</span>
    </a>
  </div>
</section>

<style>
  /* Dynamic Developer Mode Card Overrides */
  [data-mode="developer"] .name-container {
    border: 1px solid var(--border-color);
    border-radius: var(--radius-card);
    padding: 24px;
    background: var(--surface);
    text-align: left;
  }

  /* Chaos Character Reveal Animations */
  .chaos-char {
    display: inline-block;
  }

  [data-mode="chaos"] .chaos-char {
    opacity: 0;
    transform: translateZ(0);
    animation: charReveal 0.3s forwards cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes charReveal {
    to {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    [data-mode="chaos"] .chaos-char {
      opacity: 1 !important;
      animation: none !important;
    }
  }
</style>
