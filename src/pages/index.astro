---
import Award from '../layouts/Award.astro';
import Nav from '../components/award/Nav.astro';
import Hero from '../components/award/Hero.astro';
import Marquee from '../components/award/Marquee.astro';
import Stats from '../components/award/Stats.astro';
import About from '../components/award/About.astro';
import Work from '../components/award/Work.astro';
import Experience from '../components/award/Experience.astro';
import Skills from '../components/award/Skills.astro';
import Contact from '../components/award/Contact.astro';
import Footer from '../components/award/Footer.astro';
---

<Award
  title="Mohammad Zaki Jariwala, AI Product Builder"
  description="Systems engineer turned AI product builder. Four products shipped solo, three years running Tier-1 banking infrastructure. Mumbai, open to relocation."
>
  <Nav />
  <main>
    <Hero />
    <Marquee />
    <Stats />
    <Work />
    <About />
    <Experience />
    <Skills />
    <Contact />
  </main>
  <Footer />
</Award>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* ── Hero entrance: chars rise, photo unclips, foot fades ── */
  function heroIn() {
    document.querySelectorAll('.ahero-line .ch').forEach((ch, i) => {
      (ch as HTMLElement).style.transitionDelay = `${0.08 + i * 0.035}s`;
      ch.classList.add('in');
    });
    document.querySelector('[data-hero-photo]')?.classList.add('in');
    document.querySelectorAll('[data-hero-fade]').forEach(el => el.classList.add('in'));
  }

  /* ── Reveal-on-scroll for .rv elements ── */
  function reveals() {
    const els = document.querySelectorAll('.rv');
    if (reduce) {
      els.forEach(el => el.classList.add('on'));
      return;
    }
    const io = new IntersectionObserver(entries => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('on');
          io.unobserve(entry.target);
        }
      });
    }, { threshold: 0.2 });
    els.forEach(el => io.observe(el));
  }

  /* ── Animated counters on stat / KPI values ── */
  function counters() {
    if (reduce) return;
    document.querySelectorAll<HTMLElement>('[data-count]').forEach(el => {
      const raw = el.textContent ?? '';
      const m = raw.match(/^([\d,]+(?:\.\d+)?)(.*)$/);
      if (!m) return;
      const target = parseFloat(m[1].replace(/,/g, ''));
      const suffix = m[2];
      const decimals = (m[1].split('.')[1] ?? '').length;
      const useCommas = m[1].includes(',');
      const state = { v: 0 };
      gsap.to(state, {
        v: target,
        duration: 1.6,
        ease: 'power2.out',
        scrollTrigger: { trigger: el, start: 'top 88%', once: true },
        onUpdate: () => {
          let out = state.v.toFixed(decimals);
          if (useCommas) out = Number(out).toLocaleString('en-US', {
            minimumFractionDigits: decimals,
          });
          el.textContent = out + suffix;
        },
      });
    });
  }

  /* ── Hero scroll choreography: photo parallax, name lines drift apart ── */
  function heroScroll() {
    if (reduce) return;
    gsap.to('[data-hero-photo]', {
      yPercent: 18,
      ease: 'none',
      scrollTrigger: { trigger: '.ahero', start: 'top top', end: 'bottom top', scrub: true },
    });
    gsap.to('.ahero-line-1', {
      xPercent: -6,
      ease: 'none',
      scrollTrigger: { trigger: '.ahero', start: 'top top', end: 'bottom top', scrub: true },
    });
    gsap.to('.ahero-line-2', {
      xPercent: 6,
      ease: 'none',
      scrollTrigger: { trigger: '.ahero', start: 'top top', end: 'bottom top', scrub: true },
    });
  }

  /* ── Work sticky stack: pinned card dims and shrinks as the next slides over ── */
  function workStack() {
    if (reduce || window.matchMedia('(max-width: 900px)').matches) return;
    const cards = gsap.utils.toArray<HTMLElement>('[data-stack-card]');
    cards.forEach((card, i) => {
      if (i === cards.length - 1) return;
      gsap.to(card.querySelector('.awork-card-inner'), {
        scale: 0.94,
        opacity: 0.35,
        ease: 'none',
        scrollTrigger: {
          trigger: cards[i + 1],
          start: 'top bottom',
          end: 'top top',
          scrub: true,
        },
      });
    });
  }

  heroIn();
  reveals();
  counters();
  heroScroll();
  workStack();
</script>
