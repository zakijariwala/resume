---
import Dev from '../layouts/Dev.astro';
import Nav from '../components/dev/Nav.astro';
import Hero from '../components/dev/Hero.astro';
import Work from '../components/dev/Work.astro';
import Experience from '../components/dev/Experience.astro';
import Skills from '../components/dev/Skills.astro';
import Contact from '../components/dev/Contact.astro';
import Footer from '../components/dev/Footer.astro';
import meta from '../data/meta.json';

const title = `${meta.name} — engineering`;
const description = 'Systems engineer and AI product builder. Architecture decisions, stack detail, and real metrics across infrastructure and shipped products.';
---

<Dev title={title} description={description}>
  <Nav />
  <main>
    <Hero />
    <Work />
    <Experience />
    <Skills />
    <Contact />
  </main>
  <Footer />

  <!-- Mode indicator bar -->
  <div class="dmode-bar" role="navigation" aria-label="Switch audience mode">
    <span class="dmode-bar-label">// mode: <strong>developer</strong></span>
    <span class="dmode-bar-div" aria-hidden="true">|</span>
    <a href="/?mode=recruiter" class="dmode-bar-link">→ recruiter</a>
    <span class="dmode-bar-div" aria-hidden="true">|</span>
    <a href="/curious" class="dmode-bar-link">→ curious</a>
  </div>

  <!-- Floating back button -->
  <a href="/" class="back-btn" aria-label="Back to main portfolio">
    <i class="ti ti-arrow-left" aria-hidden="true"></i>
    <span>main portfolio</span>
  </a>
</Dev>

<script>
  function reveals() {
    const els = document.querySelectorAll('.rv');
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduce) { els.forEach(el => el.classList.add('on')); return; }
    const io = new IntersectionObserver(entries => {
      entries.forEach(entry => {
        if (entry.isIntersecting) { entry.target.classList.add('on'); io.unobserve(entry.target); }
      });
    }, { threshold: 0.1 });
    els.forEach(el => io.observe(el));
  }

  reveals();
  document.addEventListener('astro:page-load', reveals);
</script>

<style>
/* ── Mode bar ── */
.dmode-bar {
  position: fixed;
  top: 56px;
  left: 0;
  right: 0;
  z-index: 89;
  height: 36px;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20px;
  background: rgba(61, 220, 132, 0.04);
  border-bottom: 1px solid rgba(61, 220, 132, 0.2);
  font-family: var(--font-mono);
  font-size: 11px;
  letter-spacing: 0.04em;
  color: var(--muted);
  animation: dev-bar-pulse 2.5s ease-in-out infinite;
}
@keyframes dev-bar-pulse {
  0%, 100% { background: rgba(61, 220, 132, 0.03); border-bottom-color: rgba(61, 220, 132, 0.15); }
  50%       { background: rgba(61, 220, 132, 0.09); border-bottom-color: rgba(61, 220, 132, 0.5); }
}
.dmode-bar strong { color: var(--accent); font-weight: 500; }
.dmode-bar-div { color: var(--line-strong); }
.dmode-bar-link {
  color: var(--muted);
  text-decoration: none;
  transition: color 0.15s ease;
}
.dmode-bar-link:hover { color: var(--accent); }

/* ── Back button ── */
.back-btn {
  position: fixed;
  bottom: 24px;
  left: 24px;
  z-index: 95;
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 11px 20px;
  background: transparent;
  border: 1.5px solid var(--accent);
  font-family: var(--font-mono);
  font-size: 13px;
  font-weight: 500;
  color: var(--accent);
  text-decoration: none;
  transition: background 0.15s ease, color 0.15s ease;
}
.back-btn:hover {
  background: var(--accent);
  color: var(--bg);
}
.back-btn i { font-size: 15px; }

@media (max-width: 600px) {
  .dmode-bar { gap: 14px; }
}
@media (max-width: 480px) {
  .back-btn {
    bottom: 16px;
    left: 16px;
    padding: 9px 14px;
  }
  .back-btn span { display: none; }
}
@media (prefers-reduced-motion: reduce) {
  .dmode-bar { animation: none; }
}
</style>
